# Both rules below contradict this repo's architecture. Everything else is
# enforced — scripts/check.sh treats any other finding as a failure.

exclude_paths:
  - examples/          # reference layer for humans, not a playbook we run
  - tests/fixtures/    # deliberately minimal/invalid fixtures

skip_list:
  # Wants every role-set var prefixed with the role name. This repo's design is
  # the opposite: the variable interface is a shared, un-prefixed contract that
  # layers write and roles read. Engine-internal vars are protected by the
  # reserved-key list instead, which is enforced and tested.
  - var-naming[no-role-prefix]

  # Wants Jinja only at the end of a task name. Layer merge tasks run once per
  # layer, so the layer name has to lead to distinguish the repetitions.
  - name[template]
