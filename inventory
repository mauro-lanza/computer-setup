# This playbook is local-only (ansible-pull on the machine being configured).
# Declaring localhost silences "no inventory was parsed" warnings.
#
# ansible-pull still emits harmless "Could not match supplied host pattern"
# warnings: it auto-limits to the machine's hostname variants, which are not in
# a localhost-only inventory. Cosmetic, and not fixable without breaking
# ansible-pull's single-host assumption.
localhost ansible_connection=local
