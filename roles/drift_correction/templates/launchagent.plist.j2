<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Managed by ansible — do not edit manually.
  One template, one agent per entry in `drift_correction_agents`. Both agents
  invoke the same runner with a different mode argument.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{ agent.label }}</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{ computer_setup_runner_path }}</string>
        <string>{{ agent.mode }}</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>{{ agent.hour }}</integer>
        <key>Minute</key>
        <integer>{{ agent.minute }}</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>{{ drift_correction_log_dir }}/{{ agent.label }}.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>{{ drift_correction_log_dir }}/{{ agent.label }}.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{{ homebrew_prefix }}/bin:{{ homebrew_prefix }}/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>{{ home_dir }}</string>
    </dict>
</dict>
</plist>
