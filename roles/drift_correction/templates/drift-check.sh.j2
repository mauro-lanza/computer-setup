#!/bin/zsh
# Managed by ansible — do not edit manually
#
# Drift detection wrapper for the daily LaunchAgent.
#
# Behavior:
#   1. If offline (CONNECTIVITY_URL unreachable), log and exit 0 silently
#   2. Run `ansible-pull --check --diff` (no changes applied)
#   3. If drift is detected, post a macOS notification and exit 0
#   4. If no drift, exit silently
#   5. On error, post an error notification and exit non-zero
#
# Logs are trimmed to the last {{ drift_correction_log_max_lines }} lines to
# prevent unbounded growth (no newsyslog needed).

set -uo pipefail

REPO_URL="{{ drift_correction_repo_url }}"
PREFS_FILE="{{ drift_correction_prefs_file }}"
PLUGIN_CACHE="{{ drift_correction_plugin_cache }}"
LAYERS_FILE="{{ drift_correction_layers_manifest }}"
LOG_FILE="{{ drift_correction_log_dir }}/ansible-drift-correction.log"
ANSIBLE_PULL="{{ homebrew_prefix }}/bin/ansible-pull"
MAX_LINES={{ drift_correction_log_max_lines }}
CONNECTIVITY_URL="{{ drift_correction_connectivity_url }}"
CONNECTIVITY_TIMEOUT={{ drift_correction_connectivity_timeout }}

# Build args (include prefs + layer merge inputs only if present)
ARGS=()
[[ -f "$PREFS_FILE" ]] && ARGS+=(-e "@${PREFS_FILE}")
[[ -n "$PLUGIN_CACHE" ]] && ARGS+=(-e "computer_setup_plugin_cache=${PLUGIN_CACHE}")
[[ -f "$LAYERS_FILE" ]] && ARGS+=(-e "computer_setup_layers_manifest=${LAYERS_FILE}")

# Header for this run
{
    echo
    echo "──────────────────────────────────────────────────────────"
    echo "drift check — $(date '+%Y-%m-%d %H:%M:%S %z')"
    echo "──────────────────────────────────────────────────────────"
} >> "$LOG_FILE"

# Skip silently when offline — running ansible-pull without network produces
# a noisy "drift failed" notification that's indistinguishable from a real
# failure. Laptop closed at 10am is the common case; offline ≠ drift.
if ! /usr/bin/curl -fsS --max-time "$CONNECTIVITY_TIMEOUT" -o /dev/null "$CONNECTIVITY_URL"; then
    echo "RESULT: skipped — $CONNECTIVITY_URL unreachable (offline)" >> "$LOG_FILE"
    exit 0
fi

# Refresh every content layer in the plugin cache so the merge reflects the
# latest layer content (drift covers orchestrator + all layers). Missing cache
# entries are re-cloned from the manifest; existing layers are updated
# best-effort, leaving non-fast-forwardable repos as-is.
if [[ -n "$LAYERS_FILE" && -f "$LAYERS_FILE" && -n "$PLUGIN_CACHE" ]]; then
    mkdir -p "$PLUGIN_CACHE"
    while IFS=$'\t' read -r _layer_name _layer_repo; do
        [[ -z "$_layer_name" || -z "$_layer_repo" ]] && continue
        case "$_layer_repo" in
            https://github.com/*)
                _layer_repo="git@github.com:${_layer_repo#https://github.com/}"
                ;;
            http://github.com/*)
                _layer_repo="git@github.com:${_layer_repo#http://github.com/}"
                ;;
            github.com:*)
                _layer_repo="git@${_layer_repo}"
                ;;
        esac
        _layer_dir="$PLUGIN_CACHE/$_layer_name"
        if [[ -d "$_layer_dir/.git" ]]; then
            /usr/bin/git -C "$_layer_dir" remote set-url origin "$_layer_repo" >> "$LOG_FILE" 2>&1 \
                || echo "WARN: could not set SSH origin for layer '$_layer_name'" >> "$LOG_FILE"
            /usr/bin/git -C "$_layer_dir" pull --ff-only >> "$LOG_FILE" 2>&1 \
                || echo "WARN: could not fast-forward layer '$_layer_name'" >> "$LOG_FILE"
        else
            /usr/bin/git clone --depth 1 "$_layer_repo" "$_layer_dir" >> "$LOG_FILE" 2>&1 \
                || echo "WARN: could not clone missing layer '$_layer_name' from $_layer_repo" >> "$LOG_FILE"
        fi
    done < <({{ homebrew_prefix }}/bin/yq -r '.layers[] | [.name, .repo] | @tsv' "$LAYERS_FILE" 2>/dev/null || true)
fi

# Run ansible-pull in check mode. Capture output for parsing.
#   -e homebrew_update=false : `state=present` never upgrades, so refreshing the
#                              Homebrew index adds time with zero detection value.
PULL_OUT=$("$ANSIBLE_PULL" -U "$REPO_URL" "${ARGS[@]}" \
    -e homebrew_update=false \
    --check --diff local.yml 2>&1)
RC=$?

# Append the run output to the log
echo "$PULL_OUT" >> "$LOG_FILE"

# Trim log file to the last MAX_LINES lines (prevents unbounded growth)
if [[ -f "$LOG_FILE" ]]; then
    TMP=$(mktemp)
    tail -n "$MAX_LINES" "$LOG_FILE" > "$TMP" && mv "$TMP" "$LOG_FILE"
fi

# Helper: post a macOS notification (best-effort; non-fatal if osascript fails)
notify() {
    local title="$1" message="$2"
    /usr/bin/osascript -e "display notification \"${message}\" with title \"${title}\"" 2>/dev/null || true
}

# Parse the recap line: PLAY RECAP — count `changed=N`
# Idempotent run: changed=0 across all hosts.
#
# ansible-pull emits TWO PLAY RECAP blocks: the first is its internal repo
# checkout (always changed=1), the second is the actual playbook. We only
# care about the last recap block to avoid false-positive drift notifications.
CHANGED_COUNT=$(echo "$PULL_OUT" | awk '
    /PLAY RECAP/ { in_recap = 1; total = 0; next }
    in_recap && /changed=/ {
        match($0, /changed=[0-9]+/)
        n = substr($0, RSTART+8, RLENGTH-8)
        total += n
    }
    END { print total+0 }
')

if [[ $RC -ne 0 ]]; then
    # ansible-pull failed (network, syntax, etc.) — distinct from "drift detected"
    notify "Drift check failed" "ansible-pull exited rc=$RC. See log."
    echo "RESULT: ansible-pull failed (rc=$RC)" >> "$LOG_FILE"
    exit "$RC"
fi

if [[ "$CHANGED_COUNT" -gt 0 ]]; then
    notify "Configuration drift detected" "$CHANGED_COUNT task(s) would change. Run \`drift-apply\` to reconcile."
    echo "RESULT: drift detected ($CHANGED_COUNT changed task(s))" >> "$LOG_FILE"
else
    echo "RESULT: no drift" >> "$LOG_FILE"
fi

exit 0
