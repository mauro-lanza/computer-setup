#!/bin/bash
# Managed by ansible — do not edit manually
#
# computer-setup — the single entry point for operating this machine's setup.
#
# DELIBERATELY BASH, not zsh, even though zsh is the login shell and this used
# to be zsh: shellcheck has no zsh mode at all ("Unknown shell: zsh"), and this
# is the most operationally critical script here — every scheduled run goes
# through it. Being bash is what puts it under the linter. Nothing here needed
# zsh; it used `print`/`${var:h}` out of habit. Keep it POSIX-ish bash: macOS
# ships bash 3.2 and that is what `#!/bin/bash` resolves to.
#
# Every ansible-pull this machine runs goes through here, so the `-e` argument
# set (machine declaration, layer cache) is defined exactly once. Add a
# variable here, not per caller.
#
#   computer-setup apply [args]   Reconcile now. Streams to your terminal: no
#                                 log capture, no notification, no connectivity
#                                 guard — you can watch it fail.
#   computer-setup check [args]   Drift detection (--check --diff). Never
#                                 mutates. Logs, trims, notifies only on drift.
#                                 This is what the scheduled agent runs.
#   computer-setup upgrade        Upgrade managed tools INCLUDING casks, after
#                                 confirming in your terminal.
#   computer-setup log [n]        Tail the rolling log (default 100 lines).
#   computer-setup status [--json] What the last run did, and how long since the
#                                 last successful scheduled one.
#   computer-setup machine <sub>  Back up this machine's machine.yml to a
#                                 private repo, and restore another machine's.
#   computer-setup repos          Print a repositories.yml scaffolded from the
#                                 checkouts already on this machine.
#   computer-setup capture [...]  Diff live macOS defaults against the declared
#                                 values (delegates to macos-capture).
#   computer-setup layers <...>   Sync or lint the content layers (delegates
#                                 to computer-setup-layers).
#
# INTERNAL MODES, invoked by the LaunchAgents — not for interactive use:
#   computer-setup _scheduled-check    `check` with logging + notification
#   computer-setup _scheduled-upgrade  formulae/Galaxy/Node only, no casks
#
# The scheduled modes exit 0 when the repo is unreachable — see the
# connectivity guard below.

set -uo pipefail

REPO_URL="{{ computer_setup_repo_url }}"
REPO_BRANCH="{{ computer_setup_repo_branch }}"
# THE machine declaration: layers + answers + capability selections in one
# file. Previously two (prefs.yml and layers.yml), which meant a backup could
# be half a machine — the capability ids are meaningless without the layer
# registry that defines them.
MACHINE_FILE="{{ computer_setup_machine_file }}"
LAYER_CACHE="{{ computer_setup_layer_cache }}"
LOG_FILE="{{ computer_setup_log_file }}"
# Machine-readable run state, written by the computer_setup_state callback
# plugin (see callback_plugins/). `status` reads it; a UI could too. The plugin
# is inert unless CS_STATE_FILE is exported, which is why every mode that wants
# state recorded sets it explicitly.
STATE_FILE="{{ computer_setup_state_dir }}/last-run.json"
# Plain ISO timestamp of the last SCHEDULED run that reached the repo and
# finished cleanly. Deliberately a separate one-line file rather than a field in
# the JSON: it must survive a run that failed, and merging JSON in bash to
# preserve one field is how you end up with neither.
LAST_SUCCESS_FILE="{{ computer_setup_state_dir }}/last-success"
# Where this machine's declaration is backed up, and under what name. A file of
# its own rather than a key in machine.yml: machine.yml is the thing being
# backed up, and bootstrap rewrites it, so a machine cannot also be the place
# that records where its own backups go.
STATE_CONFIG="{{ computer_setup_config_dir }}/state.yml"
STATE_REPO_DIR="{{ computer_setup_state_repo_dir }}"
# Days without a successful scheduled run before `status` calls it stale. A
# machine that quietly stopped syncing is the failure this makes visible.
STALE_AFTER_DAYS={{ drift_correction_stale_after_days }}
ANSIBLE_PULL="{{ homebrew_prefix }}/bin/ansible-pull"
BIN_DIR="{{ computer_setup_bin_dir }}"
LAYER_SYNC="${BIN_DIR}/computer-setup-layers"
MACHINE_SYNC="${BIN_DIR}/computer-setup-machine"
MAX_LINES={{ drift_correction_log_max_lines }}
CONNECTIVITY_TIMEOUT={{ drift_correction_connectivity_timeout }}
# `| expanduser` because this is the one path here a HUMAN answers, via the
# repositories-dir question, and "~/Projects" is the natural answer. Ansible
# expands `~` itself whenever a module consumes a path, so that answer is
# correct everywhere else in the system — but baked into a shell string it
# stays literal, and `~` does not expand inside a quoted assignment.
REPOS_BASE_DIR="{{ repositories_base_dir | expanduser }}"

# ─── The pull argument set — single source of truth ──────────────────────────
ARGS=(-U "$REPO_URL" -C "$REPO_BRANCH")
# One file, so one -e @ and one path var. `layers` rides along into play scope
# as an extra-var, which is why core reserves the name against layer vars.
[[ -f "$MACHINE_FILE" ]] && ARGS+=(-e "@${MACHINE_FILE}" -e "computer_setup_machine_file=${MACHINE_FILE}")
[[ -n "$LAYER_CACHE" ]] && ARGS+=(-e "computer_setup_layer_cache=${LAYER_CACHE}")

notify() {
    /usr/bin/osascript -e "display notification \"${2}\" with title \"${1}\"" 2>/dev/null || true
}

log() { printf '%s\n' "$*" >> "$LOG_FILE"; }

usage() {
    cat <<'EOF'
computer-setup — operate this machine's configuration.

  apply [args]     Reconcile now. Streams to your terminal.
  check [args]     Drift detection (--check --diff). Never mutates.
  upgrade          Upgrade managed tools INCLUDING casks, after confirming.
  log [n]          Tail the rolling log (default 100 lines).
  status [--json]  What the last run did, and whether syncing has gone stale.
  machine <sub>    Back up / restore this machine's declaration (init|push|list|pull).
  repos [dir]      Print a repositories.yml scaffolded from existing checkouts.
  capture [args]   Diff live macOS defaults against the declared values.
  layers sync      Refresh the content-layer cache.
  layers lint      Check that layer cross-references actually resolve.

To clone repositories that are missing:  computer-setup apply --tags repositories
EOF
}

# Refresh every content layer so the merge reflects the latest layer content
# (drift covers orchestrator + all layers).
#
# EVERY mode must do this before running the playbook. ansible-pull updates the
# ORCHESTRATOR only; the layers are separate repos in a separate cache. Skipping
# it leaves the engine ahead of the layers, and any change that spans both — a
# var the engine stopped defining and a layer still references — fails the run.
# This includes `apply` — the mode a human runs by hand is the one that most
# needs current layers.
sync_layers() {
    [[ -n "$MACHINE_FILE" && -f "$MACHINE_FILE" && -n "$LAYER_CACHE" ]] || return 0
    "$LAYER_SYNC" sync --manifest "$MACHINE_FILE" --cache "$LAYER_CACHE" \
        --schema-version {{ computer_setup_schema_version }}
}

# Any mode that runs the playbook records what it did. `partial` marks a run
# that was narrowed with extra args (`--tags repositories`, `--limit`, …):
# without it `status` would report "no drift" for the WHOLE machine on the
# strength of a run that only ever looked at one role.
#
# The args themselves are deliberately NOT recorded — `-e secret=…` is a
# legitimate invocation, and this file is a report, not a shell history.
state_env() {
    CS_STATE_FILE="$STATE_FILE"
    CS_RUN_MODE="$1"
    CS_RUN_PARTIAL="$2"
    export CS_STATE_FILE CS_RUN_MODE CS_RUN_PARTIAL
}

# ─── Interactive reconcile: stream, don't capture ────────────────────────────
cmd_apply() {
    sync_layers || printf '%s\n' "WARN: layer sync failed; continuing with cached content" >&2
    # Exported through exec, so a hand-run apply updates `status` too — otherwise
    # status would describe the 10:00 agent's world and not the one you just made.
    state_env apply "$(( $# > 0 ))"
    exec "$ANSIBLE_PULL" "${ARGS[@]}" local.yml "$@"
}

# ─── Interactive drift check ─────────────────────────────────────────────────
cmd_check() {
    sync_layers || printf '%s\n' "WARN: layer sync failed; continuing with cached content" >&2
    state_env check "$(( $# > 0 ))"
    exec "$ANSIBLE_PULL" "${ARGS[@]}" -e homebrew_update=false --check --diff \
        local.yml "$@"
}

# ─── Upgrade managed tools, including casks ──────────────────────────────────
# The scheduled 09:00 agent already upgrades formulae, Galaxy and Node. It
# deliberately skips casks: those replace app bundles in /Applications and can
# raise a sudo prompt, which a LaunchAgent has no TTY to answer. This command is
# how casks get upgraded — run it when you're at the keyboard.
#
# Confirmation happens HERE, in your terminal (a guaranteed TTY), rather than via
# an in-play Ansible `pause` — a pause inside `ansible-pull` blocks forever when
# the prompt is missed and silently skips when stdin isn't interactive. This is
# why upgrade stays its own verb instead of being folded into
# `apply --tags upgrade`.
cmd_upgrade() {
    if [[ ! -t 0 ]]; then
        printf '%s\n' "computer-setup upgrade needs a terminal to confirm on." >&2
        printf '%s\n' "The scheduled agent runs the unattended, cask-free upgrade already." >&2
        return 1
    fi
    echo "computer-setup upgrade brings managed tools to their latest versions:"
    echo "  Homebrew formulae + casks, Ansible Galaxy collections, Node LTS."
    echo
    echo "Quit any app being upgraded first — replacing a running app can fail"
    echo "and leave it half-installed."
    printf "Proceed? [y/N]: "
    local reply
    read -r reply
    if [[ "$reply" != [Yy]* ]]; then
        echo "Aborted — nothing changed."
        return 0
    fi
    # Casks that replace files they own (Docker Desktop) need root. Homebrew
    # shells out to sudo, and by then we are several processes deep inside
    # Ansible with pipes for stdin — sudo has no terminal to prompt on, and a
    # credential cached with `sudo -v` out here is not usable in there either.
    #
    # The homebrew_cask module solves this properly: given `sudo_password` it
    # writes a 0700 askpass script and sets SUDO_ASKPASS, which Homebrew turns
    # into `sudo -A`. Collect the password here, where a terminal exists, and
    # hand it over through the environment — not `-e`, which would expose it in
    # the process list.
    local sudo_pw
    echo
    echo "Some casks need root to upgrade (e.g. Docker Desktop)."
    printf "macOS password (Enter to skip those casks): "
    read -rs sudo_pw
    echo
    [[ -n "$sudo_pw" ]] && export CS_SUDO_PASSWORD="$sudo_pw"
    unset sudo_pw

    sync_layers || printf '%s\n' "WARN: layer sync failed; continuing with cached content" >&2
    # Always partial: this runs `--tags upgrade`, so it says nothing about
    # whether the rest of the machine matches its configuration.
    state_env upgrade 1
    "$ANSIBLE_PULL" "${ARGS[@]}" --tags upgrade \
        -e computer_setup_upgrade_assume_yes=true local.yml "$@"
    local rc=$?
    unset CS_SUDO_PASSWORD
    return $rc
}

# ─── Run state ───────────────────────────────────────────────────────────────
# Read one field out of the state file. JSON is valid YAML and yq detects the
# .json extension, so no -p flag; yq is a bootstrap prerequisite, so it is always
# present. Missing file or missing key both yield empty, never an error: state is
# a REPORT, and a machine with no report yet is not a broken machine.
state_field() {
    [[ -f "$STATE_FILE" ]] || return 0
    yq -r "${1} // \"\"" "$STATE_FILE" 2>/dev/null | grep -v '^null$' || true
}

# Whole days since the last successful scheduled run; empty if there has never
# been one. `date -j -f` is BSD date — macOS only, which this whole system is.
days_since_success() {
    [[ -f "$LAST_SUCCESS_FILE" ]] || return 0
    local stamp then_ts now
    stamp="$(tr -d '[:space:]' < "$LAST_SUCCESS_FILE")"
    [[ -n "$stamp" ]] || return 0
    then_ts=$(date -j -f '%Y-%m-%dT%H:%M:%S%z' "$stamp" '+%s' 2>/dev/null) || return 0
    now=$(date '+%s')
    echo $(( (now - then_ts) / 86400 ))
}

# Render the changed/failed task list. `dest` is optional (not every task acts
# on a path), so it is emitted tab-separated and the tab collapsed away here —
# yq is mikefarah's, which has no jq-style `if/then/else` to inline it.
state_task_list() {
    [[ -f "$STATE_FILE" ]] || return 0
    yq -r "${1}[] | \"  - \" + .task + \"\t\" + (.dest // \"\")" "$STATE_FILE" 2>/dev/null \
        | sed -e 's/\t$//' -e 's/\t/  →  /' || true
}

cmd_status() {
    local days changed result mode finished dur
    days="$(days_since_success)"

    if [[ "${1:-}" == "--json" ]]; then
        # Composed rather than echoed: staleness is derived, and a consumer
        # should not have to reimplement the date maths to get it.
        printf '{\n'
        printf '  "last_success": "%s",\n' "$(cat "$LAST_SUCCESS_FILE" 2>/dev/null | tr -d '[:space:]')"
        printf '  "days_since_success": %s,\n' "${days:-null}"
        printf '  "stale": %s,\n' "$( [[ -n "$days" && "$days" -ge "$STALE_AFTER_DAYS" ]] && echo true || echo false )"
        printf '  "last_run": '
        if [[ -f "$STATE_FILE" ]]; then cat "$STATE_FILE"; else printf 'null\n'; fi
        printf '}\n'
        return 0
    fi

    if [[ ! -f "$STATE_FILE" ]]; then
        echo "No run recorded yet. Run \`computer-setup check\` to populate it."
        return 0
    fi

    mode="$(state_field '.mode')"
    result="$(state_field '.result')"
    finished="$(state_field '.finished')"
    dur="$(state_field '.duration_seconds')"
    changed="$(state_field '.totals.changed')"

    echo "Last run:  ${mode:-?} — ${result:-?} at ${finished:-?}${dur:+ (${dur}s)}"
    # Without this line a tag-limited run reads as a verdict on the whole
    # machine, which is the most misleading thing this file could say.
    if [[ "$(state_field '.partial')" == "true" ]]; then
        echo "           (partial run — only part of the configuration was evaluated)"
    fi

    if [[ "${changed:-0}" -gt 0 ]]; then
        if [[ "$mode" == "check" ]]; then
            echo "Drift:     ${changed} task(s) would change:"
        else
            echo "Changed:   ${changed} task(s):"
        fi
        state_task_list ".changed"
        [[ "$(state_field '.truncated')" == "true" ]] && echo "  … list truncated"
    else
        echo "Drift:     none"
    fi

    local failed_n
    failed_n="$(state_field '.totals.failed')"
    if [[ "${failed_n:-0}" -gt 0 ]]; then
        echo "Failed:    ${failed_n} task(s):"
        state_task_list ".failed"
        echo "           Run \`computer-setup log\` for the detail."
    fi

    # The point of the whole file: a machine that silently stopped syncing looks
    # identical to a healthy one until someone asks.
    if [[ -z "$days" ]]; then
        echo "Sync:      no successful scheduled run recorded yet"
    elif [[ "$days" -ge "$STALE_AFTER_DAYS" ]]; then
        echo "Sync:      STALE — last successful scheduled run was ${days} day(s) ago"
    else
        echo "Sync:      ok — last successful scheduled run ${days} day(s) ago"
    fi
}

# ─── Machine declaration backup ──────────────────────────────────────────────
# Delegated to scripts/computer-setup-machine, not implemented here, because
# bootstrap.sh needs the same operations on a machine where THIS FILE does not
# exist yet: the runner is an Ansible template deployed by the first playbook
# run, and restoring a machine has to happen before that. Same split, and the
# same reason, as computer-setup-layers.
#
# The paths are supplied here so the interactive command needs no arguments; an
# explicit flag still wins, as with `layers`.
cmd_machine() {
    local sub="${1:-}"
    [[ $# -gt 0 ]] && shift
    exec "$MACHINE_SYNC" "$sub" \
        --config "$STATE_CONFIG" \
        --repo-dir "$STATE_REPO_DIR" \
        --machine-file "$MACHINE_FILE" \
        "$@"
}

cmd_log() {
    if [[ -f "$LOG_FILE" ]]; then
        tail -n "${1:-100}" "$LOG_FILE"
    else
        echo "No log yet at $LOG_FILE"
    fi
}

# ─── Repository list scaffold ────────────────────────────────────────────────
# Prints a repositories.yml built from the checkouts already on this machine.
# To clone the repos that are MISSING, run `computer-setup apply --tags
# repositories` — the role is gated behind the `never` tag so the scheduled
# agents never clone and bootstrap never touches private repos before SSH auth
# exists. Cloning is non-destructive: existing checkouts are untouched.
cmd_repos() {
    local base="${1:-$REPOS_BASE_DIR}"
    if [[ ! -d "$base" ]]; then
        printf '%s\n' "No such directory: $base" >&2
        return 1
    fi
    echo "---"
    echo "# Generated by \`computer-setup repos\` from ${base} on $(date +%Y-%m-%d)"
    echo "# Review, then save as {{ computer_setup_repositories_override_file }}"
    echo "repositories:"
    local git_dir repo remote
    find "$base" -type d -name .git -prune 2>/dev/null | sort | while read -r git_dir; do
        repo="$(dirname "$git_dir")"
        remote="$(git -C "$repo" remote get-url origin 2>/dev/null)"
        [[ -z "$remote" ]] && continue
        echo "  - folder: \"${repo}\""
        echo "    remote: \"${remote}\""
    done
}

# ─── Scheduled modes (LaunchAgents) ──────────────────────────────────────────
# Logged, notified, and guarded on connectivity. Never interactive.
run_scheduled() {
    local mode="$1"; shift

    {
        echo
        echo "──────────────────────────────────────────────────────────"
        echo "${mode} — $(date '+%Y-%m-%d %H:%M:%S %z')"
        echo "──────────────────────────────────────────────────────────"
    } >> "$LOG_FILE"

    # EXPORTED, not scoped to the probe. A command-prefix assignment would apply
    # to `git ls-remote` alone, leaving the layer sync and the ansible-pull free
    # to hit an interactive host-key or passphrase prompt — inside a LaunchAgent
    # with no TTY, that hangs forever. BatchMode makes any such prompt an
    # immediate failure instead.
    export GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=${CONNECTIVITY_TIMEOUT} -o StrictHostKeyChecking=accept-new"

    # Probe the transport we actually use: an SSH git fetch against the real
    # repo. An HTTPS probe passes on networks that allow 443 but block 22
    # (corporate wifi, hotels, captive portals); the pull then fails and fires a
    # "check failed" notification indistinguishable from a real breakage. A
    # closed laptop, a blocked port and an expired key are all "can't work right
    # now", not "your config is broken".
    if ! git ls-remote --exit-code "$REPO_URL" "$REPO_BRANCH" >/dev/null 2>&1; then
        log "RESULT: skipped — ${REPO_URL} unreachable (offline, port 22 blocked, or SSH key unavailable)"
        exit 0
    fi

    sync_layers >> "$LOG_FILE" 2>&1 || log "WARN: layer sync failed; continuing with cached content"

    # check:   -e homebrew_update=false — `state=present` never upgrades, so
    #          refreshing the Homebrew index adds time with zero detection value.
    # upgrade: formulae/Galaxy/Node only; casks need sudo and there's no TTY.
    local -a mode_args
    if [[ "$mode" == "check" ]]; then
        mode_args=(-e homebrew_update=false --check --diff)
    else
        mode_args=(--tags upgrade -e computer_setup_upgrade_assume_yes=true
                   -e computer_setup_upgrade_include_casks=false)
    fi

    local pull_out rc partial=0
    # The scheduled upgrade is `--tags upgrade`, so like the interactive one it
    # is never a statement about the whole machine. The scheduled CHECK is.
    [[ "$mode" == "upgrade" || $# -gt 0 ]] && partial=1
    state_env "$mode" "$partial"
    pull_out=$("$ANSIBLE_PULL" "${ARGS[@]}" "${mode_args[@]}" local.yml "$@" 2>&1)
    rc=$?

    log "$pull_out"

    # Trim to the last MAX_LINES lines (prevents unbounded growth, no newsyslog).
    if [[ -f "$LOG_FILE" ]]; then
        local tmp
        tmp=$(mktemp)
        tail -n "$MAX_LINES" "$LOG_FILE" > "$tmp" && mv "$tmp" "$LOG_FILE"
    fi

    # Read the count from the state file the callback plugin wrote, NOT from the
    # console output. ansible-pull emits its own checkout play alongside the real
    # one, with [WARNING] lines interleaved between them, so every text-based
    # count has to guess which recap is which. The plugin runs inside the play
    # and simply knows.
    local changed_count
    changed_count=$(state_field '.totals.changed')
    [[ "$changed_count" =~ ^[0-9]+$ ]] || changed_count=0

    if [[ $rc -ne 0 ]]; then
        notify "computer-setup ${mode} failed" "ansible-pull exited rc=$rc. Run \`computer-setup log\`."
        log "RESULT: ansible-pull failed (rc=$rc)"
        exit "$rc"
    fi

    # Only a run that actually reached the repo and finished gets here, which is
    # exactly what "still syncing" means.
    date '+%Y-%m-%dT%H:%M:%S%z' > "$LAST_SUCCESS_FILE" 2>/dev/null || true

    if [[ "$mode" == "check" ]]; then
        if [[ "$changed_count" -gt 0 ]]; then
            notify "Configuration drift detected" "$changed_count task(s) would change. Run \`computer-setup apply\` to reconcile."
            log "RESULT: drift detected ($changed_count changed task(s))"
        else
            log "RESULT: no drift"
        fi
    else
        if [[ "$changed_count" -gt 0 ]]; then
            notify "Tools upgraded" "$changed_count task(s) changed. Casks not included — run \`computer-setup upgrade\` for those."
            log "RESULT: upgraded ($changed_count changed task(s))"
        else
            log "RESULT: already up to date"
        fi
    fi

    exit 0
}

# `layers sync`/`layers lint` default to the manifest/cache this orchestrator
# already uses everywhere else (see sync_layers() above) — without this, the
# interactive command contradicts its own usage text, which promises "layers
# sync" refreshes the cache with no further arguments. An explicit
# --manifest/--cache on the command line still wins, so overriding for a one-off
# invocation (e.g. linting a manifest that isn't deployed yet) keeps working.
cmd_layers() {
    local sub="${1:-}"
    [[ $# -gt 0 ]] && shift
    local -a args=("$@")

    if [[ "$sub" == "sync" || "$sub" == "lint" ]]; then
        local has_manifest=0 has_cache=0 a
        for a in "${args[@]+"${args[@]}"}"; do
            [[ "$a" == "--manifest" ]] && has_manifest=1
            [[ "$a" == "--cache" ]] && has_cache=1
        done
        [[ $has_cache -eq 0 && -n "$LAYER_CACHE" ]] \
            && args=(--cache "$LAYER_CACHE" "${args[@]+"${args[@]}"}")
        [[ $has_manifest -eq 0 && -f "$MACHINE_FILE" ]] \
            && args=(--manifest "$MACHINE_FILE" "${args[@]+"${args[@]}"}")
    fi

    exec "$LAYER_SYNC" "$sub" "${args[@]+"${args[@]}"}"
}

# ─── Dispatch ────────────────────────────────────────────────────────────────
COMMAND="${1:-}"
shift 2>/dev/null || true

case "$COMMAND" in
    apply)              cmd_apply "$@" ;;
    check)              cmd_check "$@" ;;
    upgrade)            cmd_upgrade "$@" ;;
    log)                cmd_log "$@" ;;
    machine)            cmd_machine "$@" ;;
    status)             cmd_status "$@" ;;
    repos)              cmd_repos "$@" ;;
    capture)            exec "${BIN_DIR}/macos-capture" "$@" ;;
    layers)             cmd_layers "$@" ;;
    _scheduled-check)   run_scheduled check "$@" ;;
    _scheduled-upgrade) run_scheduled upgrade "$@" ;;
    -h|--help|help|"")  usage ;;
    *)
        printf '%s\n' "computer-setup: unknown command '${COMMAND}'" >&2
        printf '\n' >&2
        usage >&2
        exit 64
        ;;
esac
