#!/bin/bash
# Managed by ansible — do not edit manually
#
# computer-setup — the single entry point for operating this machine's setup.
#
# Bash, not zsh: shellcheck has no zsh mode, and every scheduled run goes
# through this script. Keep it POSIX-ish: macOS ships bash 3.2.
#
# Every ansible-pull goes through here, so the `-e` argument set is defined
# once. Add a variable here, not per caller.
#
#   Verbs: see usage() below, the one list of them.
#   `apply` streams to your terminal with no connectivity guard, so you can watch
#   it fail; `check` never mutates and is what the scheduled agent runs.
#
# INTERNAL MODES, invoked by the LaunchAgents — not for interactive use:
#   computer-setup _scheduled-check    `check` with logging + notification
#   computer-setup _scheduled-upgrade  formulae/Galaxy/Node only, no casks
#
# The scheduled modes exit 0 when the repo is unreachable — see the
# connectivity guard below.

set -uo pipefail

REPO_URL="{{ computer_setup_repo_url }}"
REPO_BRANCH="{{ computer_setup_repo_branch }}"
# Layers, answers and capability selections in one file, so a backup is never
# half a machine.
MACHINE_FILE="{{ computer_setup_machine_file }}"
LAYER_CACHE="{{ computer_setup_layer_cache }}"
# One log per run, in a directory of its own. Retention: see "Run logs" in
# docs/architecture.md.
LOG_DIR="{{ computer_setup_log_dir }}"
# Successful runs are pruned past this. Failed runs are never pruned: they are
# the ones you come back to.
LOG_RETENTION_DAYS={{ drift_correction_log_retention_days }}
# Set per run by start_run_log.
RUN_LOG=""
STATE_DIR="{{ computer_setup_state_dir }}"
# Written by the computer_setup_state callback plugin, which is inert unless
# CS_STATE_FILE is set. `status` reads it.
LAST_RUN_FILE="${STATE_DIR}/last-run.json"
# Every managed path, rewritten on each complete run. Not last-run.json: that is
# what happened, this is what is.
MANIFEST_FILE="${STATE_DIR}/managed-paths.json"
# One short JSON line per run, oldest trimmed; it outlives the pruned run logs.
HISTORY_FILE="${STATE_DIR}/history.jsonl"
# Rewritten by every run, one flushed line per task, for a UI tailing a run in
# progress. Transient.
PROGRESS_FILE="${STATE_DIR}/progress.jsonl"
# Its own file, not a JSON field: a failed run must not clobber it, and merging
# JSON in bash is fragile.
LAST_SUCCESS_FILE="${STATE_DIR}/last-success"
# Same for the scheduled upgrade: `last-success` is shared with the check, which
# would hide a stale upgrade.
UPGRADE_SUCCESS_FILE="${STATE_DIR}/last-success-upgrade"
# Config, not state. Kept out of machine.yml, which is the thing being backed up.
BACKUP_CONFIG="{{ computer_setup_config_dir }}/backup.yml"
BACKUP_REPO_DIR="{{ computer_setup_backup_repo_dir }}"
# Days without a successful scheduled run before `status` reports STALE.
STALE_AFTER_DAYS={{ drift_correction_stale_after_days }}
# Pinned in runtime.yml: an unattended `brew upgrade` must not move ansible-core.
ANSIBLE_PULL="{{ computer_setup_runtime_bin }}/ansible-pull"

# Unbuffered so the log is in event order. When stdout is not a terminal,
# ansible-pull's own banner would flush after the playbook it spawns, and `log`
# tails the end.
export PYTHONUNBUFFERED=1

# ─── Mitogen ─────────────────────────────────────────────────────────────────
# A persistent interpreter instead of fork+exec per task (48.6s -> 15.4s here).
#
# CS_NO_MITOGEN=1 is the escape hatch: mitogen patches Ansible internals, and
# this runner is also how a machine pulls its own fix.
MITOGEN_STRATEGY_DIR="{{ computer_setup_runtime_tools }}/ansible-core/lib/python{{ computer_setup_python_version }}/site-packages/ansible_mitogen/plugins/strategy"
if [[ "${CS_NO_MITOGEN:-0}" != "1" && -d "$MITOGEN_STRATEGY_DIR" ]]; then
    export ANSIBLE_STRATEGY_PLUGINS="$MITOGEN_STRATEGY_DIR"
    export ANSIBLE_STRATEGY=mitogen_linear
fi
# ansible-pull's checkout of the orchestrator. Never edit it by hand: a dirty
# checkout makes ansible-pull refuse to update, and scheduled runs go stale
# silently.
PULL_DIR="{{ computer_setup_pull_dir }}"
BIN_DIR="{{ computer_setup_bin_dir }}"
LAYER_SYNC="${BIN_DIR}/computer-setup-layers"
MACHINE_SYNC="${BIN_DIR}/computer-setup-machine"
CONNECTIVITY_TIMEOUT={{ drift_correction_connectivity_timeout }}
# expanduser: a human answers this path, and `~` does not expand inside a quoted
# shell assignment.
REPOS_BASE_DIR="{{ repositories_base_dir | expanduser }}"

# ─── The pull argument set — single source of truth ──────────────────────────
# `-d` pins the checkout: otherwise ansible-pull derives it from the hostname,
# which changes with the network.
# The URL and branch also go to the play, which re-renders this script from
# them; without -e a fork or pinned ref would be reset by the next apply.
ARGS=(-U "$REPO_URL" -C "$REPO_BRANCH" -d "$PULL_DIR"
      -e "computer_setup_repo_url=${REPO_URL}" -e "computer_setup_repo_branch=${REPO_BRANCH}")
# One file, so one -e @ and one path var. `layers` rides along into play scope
# as an extra-var, which is why core reserves the name against layer vars.
[[ -f "$MACHINE_FILE" ]] && ARGS+=(-e "@${MACHINE_FILE}" -e "computer_setup_machine_file=${MACHINE_FILE}")
[[ -n "$LAYER_CACHE" ]] && ARGS+=(-e "computer_setup_layer_cache=${LAYER_CACHE}")

# The three platform-specific commands, rendered from the platform profile.
notify() {
    {{ computer_setup_platform.runner.notify }} 2>/dev/null || true
}

# Epoch mtime of a path.
file_mtime() {
    {{ computer_setup_platform.runner.mtime }} 2>/dev/null
}

# Epoch seconds of a `%Y-%m-%dT%H:%M:%S%z` stamp.
stamp_epoch() {
    {{ computer_setup_platform.runner.stamp_epoch }} 2>/dev/null
}

notify_failed() {
    notify "computer-setup ${1} failed" "Exited rc=${2}. Run \`computer-setup log\`."
}

log() { printf '%s\n' "$*" >> "${RUN_LOG:-/dev/null}"; }

# ONE run at a time: runs share the pull checkout, venv, layer cache and state,
# and launchd can run a missed job at wake. mkdir is the atomic lock; the pid
# lets a crashed holder's lock be cleared. A run suspended by sleep keeps its
# pid, correctly.
LOCK_DIR="${STATE_DIR}/run.lock"

# Returns 0 with the lock held, 1 with the holder's pid in LOCK_HOLDER.
acquire_lock() {
    mkdir -p "$STATE_DIR" 2>/dev/null || true
    # Twice: the second pass is after clearing a dead holder's lock.
    for _ in 1 2; do
        if mkdir "$LOCK_DIR" 2>/dev/null; then
            echo "$$" > "$LOCK_DIR/pid"
            trap 'rm -rf -- "$LOCK_DIR"' EXIT
            return 0
        fi
        LOCK_HOLDER="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
        if [[ -n "$LOCK_HOLDER" ]]; then
            kill -0 "$LOCK_HOLDER" 2>/dev/null && return 1
        else
            # No pid yet: mid-write (milliseconds), or died in that gap. Only the
            # latter is older than a minute.
            local age
            age=$(( $(date +%s) - $(file_mtime "$LOCK_DIR" || date +%s) ))
            (( age > 60 )) || return 1
        fi
        rm -rf -- "$LOCK_DIR"
    done
    return 1
}

# Interactive callers refuse, and say who holds it.
require_lock() {
    acquire_lock && return 0
    printf '%s\n' "computer-setup: another run is in progress (pid ${LOCK_HOLDER:-unknown}). Wait for it, or see \`computer-setup progress\`." >&2
    return 1
}

# Called first, before anything can log, so a run that skips early still has a
# log.
#
# The run id is minted here so the progress marker carries it: a reader polling
# during the layer sync would otherwise see the previous run's result.
start_run_log() {
    mkdir -p "$LOG_DIR" 2>/dev/null || true
    RUN_LOG="${LOG_DIR}/$(date '+%Y%m%d-%H%M%S')-${1}.log"
    : > "$RUN_LOG" 2>/dev/null || RUN_LOG=""
    [[ -n "$RUN_LOG" ]] && chmod 600 "$RUN_LOG" 2>/dev/null

    CS_RUN_ID="$$-$(date +%s)"
    export CS_RUN_ID
    mkdir -p "$STATE_DIR" 2>/dev/null || true
    printf '{"schema_version":1,"event":"launching","mode":"%s","run_id":"%s","started":"%s"}\n' \
        "$1" "$CS_RUN_ID" "$(date '+%Y-%m-%dT%H:%M:%S%z')" > "$PROGRESS_FILE" 2>/dev/null || true
    chmod 600 "$PROGRESS_FILE" 2>/dev/null || true
}

# Prunes only after a successful run: a failing machine should not tidy away its
# evidence.
#
# Failed runs are read from history.jsonl, one source of truth. A log with no
# history entry is kept until it ages out: it is more likely interrupted than
# litter.
prune_logs() {
    [[ -d "$LOG_DIR" ]] || return 0
    local keep old_log
    keep="$(yq -p json -r 'select(.result != "ok") | .log // ""' \
        "$HISTORY_FILE" 2>/dev/null | grep -v '^$' || true)"
    while IFS= read -r old_log; do
        if [[ -n "$keep" ]] && grep -qxF -- "$old_log" <<<"$keep"; then
            continue
        fi
        rm -f -- "$old_log"
    done < <(find "$LOG_DIR" -type f -name '*.log' -mtime +"$LOG_RETENTION_DAYS" 2>/dev/null)
}

usage() {
    cat <<'EOF'
computer-setup — operate this machine's configuration.

  apply [args]     Reconcile now. Streams to your terminal.
  check [args]     Drift detection (--check --diff). Never mutates.
  upgrade          Upgrade managed tools INCLUDING casks, after confirming.
  log [n]          Tail the most recent run's log (default 100 lines).
  log --list       Every run log kept, newest first.
  status [--json]  What the last run did, and whether syncing has gone stale.
  manifest [--json] Every file and directory this system manages.
  history [n]      The last n runs, one line each (default 20).
  progress         What a run is doing right now, if one is running.
  machine <sub>    Back up / restore this machine's declaration (init|push|list|pull).
  repos [dir]      Print a repositories.yml scaffolded from existing checkouts.
{% if computer_setup_platform.system_settings == 'osx_defaults' %}
  capture [args]   Diff live macOS defaults against the declared values.
{% endif %}
  layers sync      Refresh the content-layer cache.
  layers lint      Check that layer cross-references actually resolve.
  layers new NAME [DIR]  Scaffold a layer from the reference example (DIR defaults to ./NAME).

To clone repositories that are missing:  computer-setup apply --tags repositories
EOF
}

# Refresh every content layer before the playbook. ansible-pull updates only the
# orchestrator; a layer that lags the engine fails any run that spans both.
# Every mode does this, including `apply`.
sync_layers() {
    [[ -f "$MACHINE_FILE" && -n "$LAYER_CACHE" ]] || return 0
    "$LAYER_SYNC" sync --manifest "$MACHINE_FILE" --cache "$LAYER_CACHE" \
        --schema-version {{ computer_setup_schema_version }}
}

# Any mode that runs the playbook records what it did. `partial` marks a
# narrowed run, which must not read as a verdict on the whole machine.
#
# The args themselves are not recorded: `-e secret=…` is legitimate, and this is
# a report, not a shell history.
state_env() {
    CS_STATE_FILE="$LAST_RUN_FILE"
    CS_MANIFEST_FILE="$MANIFEST_FILE"
    CS_HISTORY_FILE="$HISTORY_FILE"
    CS_PROGRESS_FILE="$PROGRESS_FILE"
    # Lets `history` link each run to its own log.
    CS_LOG_FILE="$RUN_LOG"
    CS_RUN_MODE="$1"
    CS_RUN_PARTIAL="$2"
    # Keys the history line: the final hook can fire twice, and plays may be
    # separate processes. Minted by start_run_log.
    export CS_STATE_FILE CS_MANIFEST_FILE CS_HISTORY_FILE CS_PROGRESS_FILE CS_LOG_FILE
    export CS_RUN_MODE CS_RUN_PARTIAL CS_RUN_ID
}

# ─── Interactive reconcile: stream, don't capture ────────────────────────────
# Shared by apply and check. Runs in the foreground, streams to a terminal if
# there is one, and always writes this run's log.
#
# Not `exec`: the output must be teed and the shell must survive to prune and
# notify. See "Run logs" in docs/architecture.md.
# $1 mode, $2 partial (1 when the CALLER passed extra arguments), rest: the
# ansible-pull arguments.
#
# `partial` is a parameter: derived from $# it would always be true, since the
# callers' fixed flags are already in the argument list.
run_foreground() {
    local mode="$1" partial="$2"; shift 2
    require_lock || return 1
    start_run_log "$mode"
    sync_layers || printf '%s\n' "WARN: layer sync failed; continuing with cached content" >&2
    # Hand-run modes record state too, or `status` would describe the scheduled
    # agent's last run.
    state_env "$mode" "$partial"

    local rc
    if [[ -t 1 ]]; then
        # Interactive: streams as before, and is kept too. PIPESTATUS: tee's exit
        # code is not the run's.
        "$ANSIBLE_PULL" "${ARGS[@]}" "$@" 2>&1 | tee -a "$RUN_LOG"
        rc=${PIPESTATUS[0]}
    else
        "$ANSIBLE_PULL" "${ARGS[@]}" "$@" >> "$RUN_LOG" 2>&1
        rc=$?
    fi

    # A background run has no terminal to report to, so it notifies.
    if [[ $rc -ne 0 && ! -t 1 ]]; then
        notify_failed "$mode" "$rc"
    fi
    [[ $rc -eq 0 ]] && prune_logs
    return "$rc"
}

cmd_apply() {
    local a
    for a in "$@"; do
        [[ "$a" == --check ]] || continue
        printf '%s\n' "apply: --check is a dry run; use 'computer-setup check' (it accepts the same args)" >&2
        return 64
    done
{% if computer_setup_platform.runner.sudo_on_apply %}
    collect_sudo_password
{% endif %}
    run_foreground apply "$(( $# > 0 ))" local.yml "$@"
    local rc=$?
    unset CS_SUDO_PASSWORD
    return "$rc"
}
{% if computer_setup_platform.runner.sudo_on_apply %}

# Rendered where the platform profile sets `sudo_on_apply` (pacman and chsh
# need root, and a task never prompts). The password is asked here, checked once
# (a wrong one retried by askpass would count several failures toward a PAM
# lockout), and passed by environment, never `-e`. See "sudo on Linux" in
# docs/architecture.md.
collect_sudo_password() {
    [[ -t 0 ]] || return 0
    sudo -n true 2>/dev/null && return 0
    local pw try
    for try in 1 2; do
        printf "sudo password, for system packages and the login shell (Enter to skip): "
        read -rs pw
        echo
        if [[ -z "$pw" ]]; then
            echo "Skipping — anything that needs root is reported at the end."
            return 0
        fi
        if printf '%s\n' "$pw" | sudo -S -k -p '' true 2>/dev/null; then
            export CS_SUDO_PASSWORD="$pw"
            unset pw
            return 0
        fi
        echo "Incorrect password (attempt ${try}/2)." >&2
    done
    unset pw
    echo "Continuing without root; anything that needs it is reported at the end." >&2
}
{% endif %}

# ─── Interactive drift check ─────────────────────────────────────────────────
cmd_check() {
    run_foreground check "$(( $# > 0 ))" -e packages_brew_update=false --check --diff local.yml "$@"
}

# ─── Upgrade managed tools, including casks ──────────────────────────────────
# The 09:00 agent upgrades formulae, Galaxy and Node. Casks are left to this
# command: they replace /Applications bundles and can raise a sudo prompt that a
# LaunchAgent cannot answer.
#
# Confirms in this terminal: an Ansible `pause` blocks forever, or silently
# skips, when stdin is not interactive.
cmd_upgrade() {
    if [[ ! -t 0 ]]; then
        printf '%s\n' "computer-setup upgrade needs a terminal to confirm on." >&2
        printf '%s\n' "The scheduled agent runs the unattended, cask-free upgrade already." >&2
        return 1
    fi
    echo "computer-setup upgrade brings managed tools to their latest versions:"
    echo {{ ('  ' ~ computer_setup_platform.runner.upgrade_summary) | quote }}
{% if computer_setup_platform.runner.upgrade_warning %}
    echo
    echo {{ computer_setup_platform.runner.upgrade_warning | quote }}
{% endif %}
    printf "Proceed? [y/N]: "
    local reply
    read -r reply
    if [[ "$reply" != [Yy]* ]]; then
        echo "Aborted — nothing changed."
        return 0
    fi
{% if computer_setup_platform.runner.upgrade_sudo_prompt %}
    # Casks that need root get the password from the environment,
    # not `-e`, which would show it in the process list. The homebrew_cask module
    # feeds it to sudo through an askpass helper.
    local sudo_pw
    echo
    printf '%s' {{ computer_setup_platform.runner.upgrade_sudo_prompt | quote }}
    read -rs sudo_pw
    echo
    [[ -n "$sudo_pw" ]] && export CS_SUDO_PASSWORD="$sudo_pw"
    unset sudo_pw
{% endif %}

    # Taken after the prompts so a refusal wastes no confirmation. Logged like any
    # run: this is the one most likely to fail.
    require_lock || { unset CS_SUDO_PASSWORD; return 1; }
    start_run_log upgrade
    sync_layers || printf '%s\n' "WARN: layer sync failed; continuing with cached content" >&2
    # Always partial: `--tags upgrade` says nothing about the rest of the machine.
    state_env upgrade 1
    "$ANSIBLE_PULL" "${ARGS[@]}" --tags upgrade \
        -e computer_setup_upgrade_assume_yes=true local.yml "$@" 2>&1 | tee -a "$RUN_LOG"
    local rc=${PIPESTATUS[0]}
    unset CS_SUDO_PASSWORD
    [[ $rc -eq 0 ]] && prune_logs
    return "$rc"
}

# ─── Run state ───────────────────────────────────────────────────────────────
# The stamp in a success file, whitespace stripped; empty if missing.
read_stamp() {
    [[ -f "$1" ]] || return 0
    tr -d '[:space:]' < "$1"
}

# Whole days since the last successful scheduled run; empty if there has never
# been one.
days_since_success() {
    local stamp then_ts now
    stamp="$(read_stamp "${1:-$LAST_SUCCESS_FILE}")"
    [[ -n "$stamp" ]] || return 0
    then_ts=$(stamp_epoch "$stamp") || return 0
    now=$(date '+%s')
    echo $(( (now - then_ts) / 86400 ))
}

# Renders the changed/failed list. `dest` is optional, so the row is
# tab-separated and collapsed here; mikefarah yq has no if/then/else.
state_task_list() {
    [[ -f "$LAST_RUN_FILE" ]] || return 0
    yq -r "${1}[] | \"  - \" + .task + \"\t\" + (.dest // .item // \"\")" "$LAST_RUN_FILE" 2>/dev/null \
        | sed -e 's/\t$//' -e 's/\t/  →  /' || true
}

# Days without a successful scheduled upgrade before `status` reports BEHIND.
UPGRADE_BEHIND_DAYS=3

cmd_status() {
    local days changed result mode finished dur partial truncated failed_n stamp
    days="$(days_since_success)"

    if [[ "${1:-}" == "--json" ]]; then
        # Composed here, so consumers need not redo the date maths for staleness.
        printf '{\n'
        stamp="$(read_stamp "$LAST_SUCCESS_FILE")"
        if [[ -n "$stamp" ]]; then stamp="\"$stamp\""; else stamp=null; fi
        printf '  "last_success": %s,\n' "$stamp"
        printf '  "days_since_success": %s,\n' "${days:-null}"
        printf '  "stale": %s,\n' "$( [[ -n "$days" && "$days" -ge "$STALE_AFTER_DAYS" ]] && echo true || echo false )"
        printf '  "days_since_upgrade_success": %s,\n' "$(days_since_success "$UPGRADE_SUCCESS_FILE" | grep . || echo null)"
        printf '  "last_run": '
        if [[ -f "$LAST_RUN_FILE" ]]; then cat "$LAST_RUN_FILE"; else printf 'null\n'; fi
        printf '}\n'
        return 0
    fi

    if [[ ! -f "$LAST_RUN_FILE" ]]; then
        echo "No run recorded yet. Run \`computer-setup check\` to populate it."
        return 0
    fi

    # One yq call, `|`-delimited: a whitespace delimiter would collapse empty fields.
    # `changed` is the length of the recorded list, not `.totals.changed`: Ansible
    # counts a looped task once, so the two would disagree.
    IFS='|' read -r mode result finished dur changed partial truncated failed_n < <(
        yq -r '[.mode // "", .result // "", .finished // "", .duration_seconds // "", (.changed | length), .partial // "", .truncated // "", .totals.failed // ""] | join("|")' "$LAST_RUN_FILE" 2>/dev/null
    ) || true

    echo "Last run:  ${mode:-?} — ${result:-?} at ${finished:-?}${dur:+ (${dur}s)}"
    # A tag-limited run must not read as a verdict on the whole machine.
    if [[ "$partial" == "true" ]]; then
        echo "           (partial run — only part of the configuration was evaluated)"
    fi

    if [[ "${changed:-0}" -gt 0 ]]; then
        if [[ "$mode" == "check" ]]; then
            echo "Drift:     ${changed} task(s) would change:"
        else
            echo "Changed:   ${changed} task(s):"
        fi
        state_task_list ".changed"
        [[ "$truncated" == "true" ]] && echo "  … list truncated"
    else
        echo "Drift:     none"
    fi

    if [[ "${failed_n:-0}" -gt 0 ]]; then
        echo "Failed:    ${failed_n} task(s):"
        state_task_list ".failed"
        echo "           Run \`computer-setup log\` for the detail."
    fi

    # The detail lives in `computer-setup manifest`; this is the pointer.
    local orphan_n
    orphan_n="$(yq -r '.orphans // [] | length' "$MANIFEST_FILE" 2>/dev/null || true)"
    if [[ "${orphan_n:-0}" =~ ^[0-9]+$ && "${orphan_n:-0}" -gt 0 ]]; then
        echo "Orphans:   ${orphan_n} path(s) no longer managed but still on disk"
        echo "           See \`computer-setup manifest\`. Nothing is deleted automatically."
    fi

    # A machine that silently stopped syncing looks healthy until someone checks.
    if [[ -z "$days" ]]; then
        echo "Sync:      no successful scheduled run recorded yet"
    elif [[ "$days" -ge "$STALE_AFTER_DAYS" ]]; then
        echo "Sync:      STALE — last successful scheduled run was ${days} day(s) ago"
    else
        echo "Sync:      ok — last successful scheduled run ${days} day(s) ago"
    fi
    # Only once an upgrade has been recorded: a machine without the agent is not nagged.
    local up_days
    up_days="$(days_since_success "$UPGRADE_SUCCESS_FILE")"
    if [[ -n "$up_days" && "$up_days" -ge "$UPGRADE_BEHIND_DAYS" ]]; then
        echo "Upgrade:   BEHIND — last successful scheduled upgrade was ${up_days} day(s) ago (see \`computer-setup log --list\`)"
    fi
}

# ─── What this system owns ───────────────────────────────────────────────────
# Which files are mine. Written by the run-state callback, so it records what the
# run managed, not a hand-kept list that could disagree with it.
cmd_manifest() {
    if [[ ! -f "$MANIFEST_FILE" ]]; then
        echo "No manifest yet. Run \`computer-setup check\` to populate it."
        return 0
    fi
    if [[ "${1:-}" == "--json" ]]; then
        cat "$MANIFEST_FILE"
        return 0
    fi

    local generated n_files n_dirs n_backups n_orphans
    IFS='|' read -r generated n_files n_dirs n_backups n_orphans < <(
        yq -r '[.generated // "", (.files | length), (.directories | length), (.backups | length), (.orphans // [] | length)] | join("|")' "$MANIFEST_FILE" 2>/dev/null
    ) || true

    # Only complete runs write this file, so it may predate the last run; the
    # timestamp shows how old it is.
    echo "Recorded:  ${generated:-?}"
    echo
    echo "Files (${n_files:-0}):"
    yq -r '.files[] | "  " + .path + "\t" + (.role // "-")' "$MANIFEST_FILE" 2>/dev/null \
        | column -t -s $'\t'
    echo
    echo "Directories (${n_dirs:-0}):"
    yq -r '.directories[] | "  " + .path' "$MANIFEST_FILE" 2>/dev/null
    # Ansible's `backup: true` residue: nothing reads or removes it, so it is
    # listed apart.
    if [[ "${n_backups:-0}" -gt 0 ]]; then
        echo
        echo "Backup copies left behind (${n_backups}):"
        yq -r '.backups[] | "  " + .path' "$MANIFEST_FILE" 2>/dev/null
    fi
    # Still on disk, but no active capability writes them. Reported, never
    # removed: deleting is a judgement.
    if [[ "${n_orphans:-0}" -gt 0 ]]; then
        echo
        echo "No longer managed, still on disk (${n_orphans}):"
        yq -r '.orphans[] | "  " + .path + "\t" + ("was " + (.role // "?")) + "\tsince " + (.since // "?")' \
            "$MANIFEST_FILE" 2>/dev/null | column -t -s $'\t'
        echo
        echo "  Nothing is deleted automatically. Remove what you recognise."
    fi
}

# ─── Run history ─────────────────────────────────────────────────────────────
# Answers "when did this machine last apply anything" after run logs are pruned.
cmd_history() {
    if [[ ! -f "$HISTORY_FILE" ]]; then
        echo "No history yet. It is appended to by every run."
        return 0
    fi
    local n="${1:-20}"
    [[ "$n" =~ ^[0-9]+$ ]] || { printf '%s\n' "history: expected a number, got '$n'" >&2; return 64; }

    # One yq over the whole slice, not one per line.
    #
    # `partial` is a plain field, turned into the asterisk by awk: yq has no
    # if/then/else (see docs/findings.md).
    {
        printf '%-26s %-8s %-8s %8s %8s %9s\n' FINISHED MODE RESULT CHANGED FAILED DURATION
        # HISTORY_TSV_EXPR: kept on one line so check.sh can lift it out and test
        # it. A broken expression fails silently: the rows vanish.
        tail -n "$n" "$HISTORY_FILE" \
            | yq -p json -r '[.finished, .mode, .result, (.partial | tostring), (.changed | tostring), (.failed | tostring), (.duration_seconds | tostring)] | @tsv' \
            | awk -F'\t' '{
                mode = $2 ($4 == "true" ? "*" : "")
                printf "%-26s %-8s %-8s %8s %8s %8ss\n", $1, mode, $3, $5, $6, $7
              }'
    }
    echo
    echo "* = partial run (narrowed by tags or arguments)"
}

# ─── Live progress ───────────────────────────────────────────────────────────
# Seconds without progress before `progress` reports a run as stalled.
PROGRESS_STALLED_SECONDS=300

# For runs you did not start (09:00 upgrade, 10:00 check): otherwise invisible
# while they run. Interactive runs print their own progress.
cmd_progress() {
    if [[ ! -f "$PROGRESS_FILE" ]]; then
        echo "No run has recorded progress yet."
        return 0
    fi
    local head last head_event mode total last_event result tasks n current
    head="$(head -n1 "$PROGRESS_FILE")"
    last="$(tail -n1 "$PROGRESS_FILE")"
    # Empty fields survive `read` because `|` is not whitespace; a half-written
    # line leaves them empty. Task goes last: it may hold `|`.
    IFS='|' read -r head_event mode total < <(yq -r \
        '[.event, (.mode | tostring), (.total_estimate // 0)] | join("|")' <<<"$head" 2>/dev/null)
    IFS='|' read -r last_event result tasks n current < <(yq -r \
        '[.event, (.result // ""), (.tasks | tostring), (.n // 0), (.task // "")] | join("|")' <<<"$last" 2>/dev/null)

    if [[ "$last_event" == "end" && -n "$result" ]]; then
        printf 'Not running. Last run: %s — %s (%s task(s))\n' "$mode" "$result" "$tasks"
        return 0
    fi

    if [[ "$head_event" == "launching" ]]; then
        printf '%s  starting — syncing layers and fetching the orchestrator\n' "$mode"
        return 0
    fi

    # No end marker does not mean live: the run may have been killed. mtime tells
    # the two apart.
    local age
    age=$(( $(date +%s) - $(file_mtime "$PROGRESS_FILE" || echo 0) ))
    if [[ "$age" -gt "$PROGRESS_STALLED_SECONDS" ]]; then
        printf 'Stalled or interrupted — no progress for %sm, stopped at task %s.\n' \
            "$(( age / 60 ))" "${n:-?}"
        printf '  last: %s\n' "$current"
        return 0
    fi

    if [[ "${total:-0}" -gt 0 ]]; then
        local pct filled bar i
        pct=$(( 100 * n / total ))
        # The estimate is the previous run of this mode, so clamp rather than
        # render past 100%.
        [[ "$pct" -gt 100 ]] && pct=100
        filled=$(( pct / 5 ))
        # Built a character at a time: printf with no arguments still prints its
        # format once.
        bar=""
        for (( i = 0; i < 20; i++ )); do
            if (( i < filled )); then bar+="#"; else bar+="."; fi
        done
        printf '%s  [%s] %s%%  %s/%s\n' "$mode" "$bar" "$pct" "$n" "$total"
    else
        # First run of a mode has no previous run to size against.
        printf '%s  task %s (no estimate yet — needs one completed run of this mode)\n' \
            "$mode" "$n"
    fi
    printf '  now: %s\n' "$current"
}

# ─── Machine declaration backup ──────────────────────────────────────────────
# Lives in scripts/computer-setup-machine: bootstrap.sh needs the same operations
# before this template is deployed. Same split as computer-setup-layers.
#
# The paths are supplied here so the command needs no arguments; an explicit
# flag still wins, as with `layers`.
cmd_machine() {
    local sub="${1:-}"
    [[ $# -gt 0 ]] && shift
    exec "$MACHINE_SYNC" "$sub" \
        --config "$BACKUP_CONFIG" \
        --repo-dir "$BACKUP_REPO_DIR" \
        --machine-file "$MACHINE_FILE" \
        "$@"
}

# Log names are `YYYYmmdd-HHMMSS-<mode>.log`, so lexical order is chronological.
cmd_log() {
    local arg="${1:-100}"
    set -- "$LOG_DIR"/*.log
    if [[ ! -f "$1" ]]; then
        echo "No logs yet in $LOG_DIR"
        return 0
    fi
    if [[ "$arg" == "--list" ]]; then
        printf '%s\n' "$@" | sort -r
        return 0
    fi
    [[ "$arg" =~ ^[0-9]+$ ]] || { printf '%s\n' "log: expected a number, got '$arg'" >&2; return 64; }
    local latest="${!#}"
    printf '%s\n\n' "── $latest"
    tail -n "$arg" "$latest"
}

# ─── Repository list scaffold ────────────────────────────────────────────────
# Prints a repositories.yml built from the checkouts already on this machine.
# To clone the missing repos: `computer-setup apply --tags repositories`. That tag
# is `never`, so scheduled agents and bootstrap never clone. Existing checkouts
# are untouched.
cmd_repos() {
    local base="${1:-$REPOS_BASE_DIR}"
    if [[ ! -d "$base" ]]; then
        printf '%s\n' "No such directory: $base" >&2
        return 1
    fi
    echo "---"
    echo "# Generated by \`computer-setup repos\` from ${base} on $(date +%Y-%m-%d)"
    echo "# Review, then save as {{ computer_setup_repositories_override_file }}"
    echo "repositories:"
    local git_dir repo remote
    find "$base" -type d -name .git -prune 2>/dev/null | sort | while read -r git_dir; do
        repo="$(dirname "$git_dir")"
        remote="$(git -C "$repo" remote get-url origin 2>/dev/null)"
        [[ -z "$remote" ]] && continue
        echo "  - folder: \"${repo}\""
        echo "    remote: \"${remote}\""
    done
}
{% if computer_setup_platform.system_settings == 'osx_defaults' %}

cmd_capture() {
    exec "${BIN_DIR}/macos-capture" "$@"
}
{% endif %}

# ─── Scheduled modes (LaunchAgents) ──────────────────────────────────────────
# Retried: the network is often not up at 09:00 (wake, VPN). Stderr is logged,
# since a bare "unreachable" cannot be diagnosed afterwards.
repo_reachable() {
    local tries=3 try err
    for ((try = 1; try <= tries; try++)); do
        if err=$(git ls-remote --exit-code "$REPO_URL" "$REPO_BRANCH" 2>&1 >/dev/null); then
            return 0
        fi
        log "probe ${try}/${tries} failed: ${err:-no output}"
        if [[ $try -lt $tries ]]; then sleep "${PROBE_RETRY_DELAY:-20}"; fi
    done
    return 1
}

# Logged, notified, and guarded on connectivity. Never interactive.
run_scheduled() {
    local mode="$1"; shift
    # Before start_run_log, which claims the progress file; a skipped run leaves
    # no log on purpose.
    if ! acquire_lock; then
        echo "computer-setup ${mode}: skipped, another run is in progress (pid ${LOCK_HOLDER:-unknown})"
        exit 0
    fi
    start_run_log "$mode"

    {
        echo "──────────────────────────────────────────────────────────"
        echo "${mode} — $(date '+%Y-%m-%d %H:%M:%S %z')"
        echo "──────────────────────────────────────────────────────────"
    } >> "$RUN_LOG"

    # Exported, not a per-command prefix: otherwise the layer sync and ansible-pull
    # could hang on a host-key or passphrase prompt with no TTY.
    # BatchMode turns any such prompt into an immediate failure.
    export GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=${CONNECTIVITY_TIMEOUT} -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=accept-new"

    # Probe the transport we use (SSH to the real repo): an HTTPS probe passes
    # where port 22 is blocked, and the pull would then fail like a real breakage.
    # Offline, a blocked port and a bad key all mean "can't work now".
    if ! repo_reachable; then
        log "RESULT: skipped — ${REPO_URL} unreachable (offline, port 22 blocked, or SSH key unavailable)"
        exit 0
    fi

    sync_layers >> "$RUN_LOG" 2>&1 || log "WARN: layer sync failed; continuing with cached content"

    # check:   -e packages_brew_update=false: `state=present` never upgrades, so the
    #          index refresh detects nothing.
    # upgrade: formulae/Galaxy/Node only; casks need sudo, which has no TTY here.
    #
    # Non-interactive in every scheduled mode: anything that would prompt is
    # reported instead.
    local -a mode_args=(-e computer_setup_interactive=false)
    if [[ "$mode" == "check" ]]; then
        mode_args+=(-e packages_brew_update=false --check --diff)
    else
        mode_args+=(--tags upgrade -e computer_setup_upgrade_assume_yes=true
                    -e computer_setup_upgrade_include_casks=false)
    fi

    local pull_out rc changed_count partial=0
    # The scheduled upgrade is partial (`--tags upgrade`); the scheduled check is not.
    [[ "$mode" == "upgrade" || $# -gt 0 ]] && partial=1
    state_env "$mode" "$partial"
    pull_out=$("$ANSIBLE_PULL" "${ARGS[@]}" "${mode_args[@]}" local.yml "$@" 2>&1)
    rc=$?

    log "$pull_out"

    if [[ $rc -ne 0 ]]; then
        notify_failed "$mode" "$rc"
        log "RESULT: ansible-pull failed (rc=$rc)"
        exit "$rc"
    fi

    # From the callback's state file, not console output: ansible-pull prints two
    # recaps, interleaved with warnings. A missing file or key leaves it
    # non-numeric, hence 0.
    changed_count=$(yq -r '.totals.changed' "$LAST_RUN_FILE" 2>/dev/null)
    [[ "$changed_count" =~ ^[0-9]+$ ]] || changed_count=0

    # Only a run that reached the repo and finished writes these stamps.
    local ts
    ts=$(date '+%Y-%m-%dT%H:%M:%S%z')
    printf '%s\n' "$ts" > "$LAST_SUCCESS_FILE" 2>/dev/null || true
    if [[ "$mode" == "upgrade" ]]; then
        printf '%s\n' "$ts" > "$UPGRADE_SUCCESS_FILE" 2>/dev/null || true
    fi
    prune_logs

    if [[ "$mode" == "check" ]]; then
        if [[ "$changed_count" -gt 0 ]]; then
            notify "Configuration drift detected" "$changed_count task(s) would change. Run \`computer-setup apply\` to reconcile."
            log "RESULT: drift detected ($changed_count changed task(s))"
        else
            log "RESULT: no drift"
        fi
    else
        if [[ "$changed_count" -gt 0 ]]; then
            notify "Tools upgraded" "$changed_count task(s) changed. Casks not included — run \`computer-setup upgrade\` for those."
            log "RESULT: upgraded ($changed_count changed task(s))"
        else
            log "RESULT: already up to date"
        fi
    fi

    exit 0
}

# `layers sync`/`lint` default to the cache and manifest this runner uses; an
# explicit --manifest/--cache still wins.
has_arg() {
    local want="$1" a
    shift
    for a in "$@"; do
        [[ "$a" == "$want" ]] && return 0
    done
    return 1
}

cmd_layers_new() {
    local lname="${1:-}" ldir="${2:-}" src="${PULL_DIR}/examples/example-layer"
    [[ "$lname" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] \
        || { echo "Usage: computer-setup layers new NAME [DIR]  (NAME: letters, digits, . _ -)" >&2; return 64; }
    [[ -n "$ldir" ]] || ldir="./${lname}"
    [[ -d "$src" ]] || { echo "No reference layer at ${src}; run \`computer-setup apply\` first." >&2; return 1; }
    [[ ! -e "$ldir" ]] || { echo "${ldir} already exists." >&2; return 1; }
    cp -R "$src" "$ldir" || return 1
    # Only the name line: the layer's name must match its manifest entry.
    yq -i ".name = \"${lname}\"" "$ldir/layer.yml" || return 1
    echo "Created ${ldir}. Edit it, git init + push, then add it to machine.yml (see machine.example.yml)."
}

cmd_layers() {
    local sub="${1:-}"
    [[ $# -gt 0 ]] && shift
    [[ "$sub" == "new" ]] && { cmd_layers_new "$@"; return; }
    local -a args=("$@")

    if [[ "$sub" == "sync" || "$sub" == "lint" ]]; then
        has_arg --cache "${args[@]+"${args[@]}"}" || [[ -z "$LAYER_CACHE" ]] \
            || args=(--cache "$LAYER_CACHE" "${args[@]+"${args[@]}"}")
        has_arg --manifest "${args[@]+"${args[@]}"}" || [[ ! -f "$MACHINE_FILE" ]] \
            || args=(--manifest "$MACHINE_FILE" "${args[@]+"${args[@]}"}")
    fi

    # Lint also checks this machine's own selections, unless pointed at one layer.
    if [[ "$sub" == "lint" && -f "$MACHINE_FILE" ]]; then
        has_arg --layer "${args[@]+"${args[@]}"}" || has_arg --machine "${args[@]+"${args[@]}"}" \
            || args+=(--machine "$MACHINE_FILE")
    fi

    exec "$LAYER_SYNC" "$sub" "${args[@]+"${args[@]}"}"
}

# ─── Dispatch ────────────────────────────────────────────────────────────────
COMMAND="${1:-}"
shift 2>/dev/null || true

case "$COMMAND" in
    apply)              cmd_apply "$@" ;;
    check)              cmd_check "$@" ;;
    upgrade)            cmd_upgrade "$@" ;;
    log)                cmd_log "$@" ;;
    machine)            cmd_machine "$@" ;;
    status)             cmd_status "$@" ;;
    manifest)           cmd_manifest "$@" ;;
    history)            cmd_history "$@" ;;
    progress)           cmd_progress "$@" ;;
    repos)              cmd_repos "$@" ;;
{% if computer_setup_platform.system_settings == 'osx_defaults' %}
    capture)            cmd_capture "$@" ;;
{% endif %}
    layers)             cmd_layers "$@" ;;
    _scheduled-check)   run_scheduled check "$@" ;;
    _scheduled-upgrade) run_scheduled upgrade "$@" ;;
    -h|--help|help|"")  usage ;;
    *)
        printf '%s\n' "computer-setup: unknown command '${COMMAND}'" >&2
        printf '\n' >&2
        usage >&2
        exit 64
        ;;
esac
