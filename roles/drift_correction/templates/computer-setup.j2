#!/bin/bash
# Managed by ansible — do not edit manually
#
# computer-setup — the single entry point for operating this machine's setup.
#
# DELIBERATELY BASH, not zsh, even though zsh is the login shell and this used
# to be zsh: shellcheck has no zsh mode at all ("Unknown shell: zsh"), and this
# is the most operationally critical script here — every scheduled run goes
# through it. Being bash is what puts it under the linter. Nothing here needed
# zsh; it used `print`/`${var:h}` out of habit. Keep it POSIX-ish bash: macOS
# ships bash 3.2 and that is what `#!/bin/bash` resolves to.
#
# Every ansible-pull this machine runs goes through here, so the `-e` argument
# set (machine declaration, layer cache) is defined exactly once. Add a
# variable here, not per caller.
#
#   computer-setup apply [args]   Reconcile now. Streams to your terminal: no
#                                 log capture, no notification, no connectivity
#                                 guard — you can watch it fail.
#   computer-setup check [args]   Drift detection (--check --diff). Never
#                                 mutates. Logs, trims, notifies only on drift.
#                                 This is what the scheduled agent runs.
#   computer-setup upgrade        Upgrade managed tools INCLUDING casks, after
#                                 confirming in your terminal.
#   computer-setup log [n]        Tail the rolling log (default 100 lines).
#   computer-setup status [--json] What the last run did, and how long since the
#                                 last successful scheduled one.
#   computer-setup machine <sub>  Back up this machine's machine.yml to a
#                                 private repo, and restore another machine's.
#   computer-setup repos          Print a repositories.yml scaffolded from the
#                                 checkouts already on this machine.
#   computer-setup capture [...]  Diff live macOS defaults against the declared
#                                 values (delegates to macos-capture).
#   computer-setup layers <...>   Sync or lint the content layers (delegates
#                                 to computer-setup-layers).
#
# INTERNAL MODES, invoked by the LaunchAgents — not for interactive use:
#   computer-setup _scheduled-check    `check` with logging + notification
#   computer-setup _scheduled-upgrade  formulae/Galaxy/Node only, no casks
#
# The scheduled modes exit 0 when the repo is unreachable — see the
# connectivity guard below.

set -uo pipefail

REPO_URL="{{ computer_setup_repo_url }}"
REPO_BRANCH="{{ computer_setup_repo_branch }}"
# THE machine declaration: layers + answers + capability selections in one
# file. Previously two (prefs.yml and layers.yml), which meant a backup could
# be half a machine — the capability ids are meaningless without the layer
# registry that defines them.
MACHINE_FILE="{{ computer_setup_machine_file }}"
LAYER_CACHE="{{ computer_setup_layer_cache }}"
# ONE LOG PER RUN, in a directory of their own. Previously every scheduled run
# appended to a single rolling file trimmed to a line count — which held about
# three days, had no per-run boundaries, and recorded only SCHEDULED runs: an
# interactive apply printed to your terminal and was never kept at all.
#
# Per-run files make "open the log for THAT run" answerable, which a menu that
# lists recent runs needs, and they make retention a policy rather than a
# guillotine that drops whatever fell off the end.
LOG_DIR="{{ computer_setup_log_dir }}"
# Successful runs are pruned past this. FAILED RUNS ARE NEVER PRUNED: the whole
# point of keeping logs is the run that went wrong, and those are exactly the
# ones you come back to weeks later.
LOG_RETENTION_DAYS={{ drift_correction_log_retention_days }}
# Set per run by start_run_log.
RUN_LOG=""
# Machine-readable run state, written by the computer_setup_state callback
# plugin (see callback_plugins/). `status` reads it; a UI could too. The plugin
# is inert unless CS_STATE_FILE is exported, which is why every mode that wants
# state recorded sets it explicitly.
STATE_FILE="{{ computer_setup_state_dir }}/last-run.json"
# Every filesystem path this system manages, rewritten each complete run. The
# basis for auditing what the tool owns, and later for collecting what it has
# stopped owning. Separate from last-run.json because it answers a different
# question: that file is what HAPPENED, this is what IS.
MANIFEST_FILE="{{ computer_setup_state_dir }}/managed-paths.json"
# One JSON line per run, oldest trimmed. The rolling log holds about three days
# because it stores full Ansible output; this holds most of a year because it
# stores nine fields.
HISTORY_FILE="{{ computer_setup_state_dir }}/history.jsonl"
# LIVE progress, rewritten by every run: one line per task, flushed as it goes.
# What a UI tails to show a run happening rather than a spinner. Transient by
# design — the previous run's progress is of no interest to anyone.
PROGRESS_FILE="{{ computer_setup_state_dir }}/progress.jsonl"
# Plain ISO timestamp of the last SCHEDULED run that reached the repo and
# finished cleanly. Deliberately a separate one-line file rather than a field in
# the JSON: it must survive a run that failed, and merging JSON in bash to
# preserve one field is how you end up with neither.
LAST_SUCCESS_FILE="{{ computer_setup_state_dir }}/last-success"
# Where this machine's declaration is backed up, and under what name. CONFIG,
# not state: you choose it, it is hand-editable, and losing it means deciding
# again. A file of its own rather than a key in machine.yml, because machine.yml
# is the thing being backed up — a machine cannot be the place that records
# where its own backups go.
BACKUP_CONFIG="{{ computer_setup_config_dir }}/backup.yml"
BACKUP_REPO_DIR="{{ computer_setup_backup_repo_dir }}"
# Days without a successful scheduled run before `status` calls it stale. A
# machine that quietly stopped syncing is the failure this makes visible.
STALE_AFTER_DAYS={{ drift_correction_stale_after_days }}
# The engine's PINNED runtime, not whatever `ansible` Homebrew happens to have.
# See runtime.yml: brew upgrade runs unattended at 09:00 and could otherwise
# cross an ansible-core major on every machine overnight.
ANSIBLE_PULL="{{ computer_setup_runtime_bin }}/ansible-pull"

# ─── Mitogen ─────────────────────────────────────────────────────────────────
# Replaces Ansible's fork+exec per task with a persistent interpreter. Measured
# on this playbook: 48.6s -> 15.4s, identical results.
#
# Enabled only when the strategy plugin is actually present, and skippable with
# CS_NO_MITOGEN=1. That escape hatch matters more than it looks: mitogen
# monkey-patches Ansible internals, so a bad interaction breaks ansible-playbook
# itself — and this runner is also how the machine would PULL the fix. Without a
# way to run without it, a broken mitogen would leave a machine unable to heal
# itself. `CS_NO_MITOGEN=1 computer-setup apply` is that way.
MITOGEN_STRATEGY_DIR="{{ computer_setup_runtime_tools }}/ansible-core/lib/python{{ computer_setup_python_version }}/site-packages/ansible_mitogen/plugins/strategy"
use_mitogen() {
    [[ "${CS_NO_MITOGEN:-0}" == "1" ]] && return 1
    [[ -d "$MITOGEN_STRATEGY_DIR" ]]
}
if use_mitogen; then
    export ANSIBLE_STRATEGY_PLUGINS="$MITOGEN_STRATEGY_DIR"
    export ANSIBLE_STRATEGY=mitogen_linear
fi
# ansible-pull's checkout of the orchestrator. Never edit it by hand: a dirty
# checkout makes ansible-pull refuse to update (it clones with force=no), and
# the scheduled agents then run stale code with no visible complaint.
PULL_DIR="{{ computer_setup_pull_dir }}"
BIN_DIR="{{ computer_setup_bin_dir }}"
LAYER_SYNC="${BIN_DIR}/computer-setup-layers"
MACHINE_SYNC="${BIN_DIR}/computer-setup-machine"
CONNECTIVITY_TIMEOUT={{ drift_correction_connectivity_timeout }}
# `| expanduser` because this is the one path here a HUMAN answers, via the
# repositories-dir question, and "~/Projects" is the natural answer. Ansible
# expands `~` itself whenever a module consumes a path, so that answer is
# correct everywhere else in the system — but baked into a shell string it
# stays literal, and `~` does not expand inside a quoted assignment.
REPOS_BASE_DIR="{{ repositories_base_dir | expanduser }}"

# ─── The pull argument set — single source of truth ──────────────────────────
# `-d` pins the checkout. Without it ansible-pull derives the directory from the
# hostname, which on a Mac changes with the network (an mDNS `.home` suffix), so
# each network would get its own clone and each would be stale until that
# network came back.
ARGS=(-U "$REPO_URL" -C "$REPO_BRANCH" -d "$PULL_DIR")
# One file, so one -e @ and one path var. `layers` rides along into play scope
# as an extra-var, which is why core reserves the name against layer vars.
[[ -f "$MACHINE_FILE" ]] && ARGS+=(-e "@${MACHINE_FILE}" -e "computer_setup_machine_file=${MACHINE_FILE}")
[[ -n "$LAYER_CACHE" ]] && ARGS+=(-e "computer_setup_layer_cache=${LAYER_CACHE}")

notify() {
    /usr/bin/osascript -e "display notification \"${2}\" with title \"${1}\"" 2>/dev/null || true
}

log() { printf '%s\n' "$*" >> "${RUN_LOG:-/dev/null}"; }

# Opens this run's log and claims the progress file. Called FIRST, before
# anything else can log — including the connectivity probe that may exit early,
# because a run that skipped is still a run someone may ask about.
#
# The run id is minted here rather than in state_env so the progress marker can
# carry it. state_env runs after the layer sync, which is several seconds of
# git, and a reader polling during that window would otherwise be told the
# previous run's result as though it were this one.
start_run_log() {
    mkdir -p "$LOG_DIR" 2>/dev/null || true
    RUN_LOG="${LOG_DIR}/$(date '+%Y%m%d-%H%M%S')-${1}.log"
    : > "$RUN_LOG" 2>/dev/null || RUN_LOG=""
    [[ -n "$RUN_LOG" ]] && chmod 600 "$RUN_LOG" 2>/dev/null

    CS_RUN_ID="$$-$(date +%s)"
    export CS_RUN_ID
    mkdir -p "$(dirname "$PROGRESS_FILE")" 2>/dev/null || true
    printf '{"schema_version":1,"event":"launching","mode":"%s","run_id":"%s","started":"%s"}\n' \
        "$1" "$CS_RUN_ID" "$(date '+%Y-%m-%dT%H:%M:%S%z')" > "$PROGRESS_FILE" 2>/dev/null || true
    chmod 600 "$PROGRESS_FILE" 2>/dev/null || true
}

# Delete successful runs' logs past the retention window, and only after a run
# that itself succeeded — a machine that is failing should not be quietly
# tidying away the evidence.
#
# Which runs failed is read from history.jsonl rather than encoded in filenames,
# so there is one source of truth and no rename to get wrong. A log with no
# history entry at all is treated as keepable until it ages out: it is more
# likely an interrupted run than litter.
prune_logs() {
    [[ -d "$LOG_DIR" ]] || return 0
    local keep old_log
    keep="$(yq -p json -r 'select(.result != "ok") | .log // ""' \
        "$HISTORY_FILE" 2>/dev/null | grep -v '^$' || true)"
    while IFS= read -r old_log; do
        [[ -z "$old_log" ]] && continue
        if [[ -n "$keep" ]] && printf '%s\n' "$keep" | grep -qxF -- "$old_log"; then
            continue
        fi
        rm -f -- "$old_log"
    done < <(find "$LOG_DIR" -type f -name '*.log' -mtime +"$LOG_RETENTION_DAYS" 2>/dev/null)
}

usage() {
    cat <<'EOF'
computer-setup — operate this machine's configuration.

  apply [args]     Reconcile now. Streams to your terminal.
  check [args]     Drift detection (--check --diff). Never mutates.
  upgrade          Upgrade managed tools INCLUDING casks, after confirming.
  log [n]          Tail the most recent run's log (default 100 lines).
  log --list       Every run log kept, newest first.
  status [--json]  What the last run did, and whether syncing has gone stale.
  manifest [--json] Every file and directory this system manages.
  history [n]      The last n runs, one line each (default 20).
  progress         What a run is doing right now, if one is running.
  machine <sub>    Back up / restore this machine's declaration (init|push|list|pull).
  repos [dir]      Print a repositories.yml scaffolded from existing checkouts.
  capture [args]   Diff live macOS defaults against the declared values.
  layers sync      Refresh the content-layer cache.
  layers lint      Check that layer cross-references actually resolve.

To clone repositories that are missing:  computer-setup apply --tags repositories
EOF
}

# Refresh every content layer so the merge reflects the latest layer content
# (drift covers orchestrator + all layers).
#
# EVERY mode must do this before running the playbook. ansible-pull updates the
# ORCHESTRATOR only; the layers are separate repos in a separate cache. Skipping
# it leaves the engine ahead of the layers, and any change that spans both — a
# var the engine stopped defining and a layer still references — fails the run.
# This includes `apply` — the mode a human runs by hand is the one that most
# needs current layers.
sync_layers() {
    [[ -n "$MACHINE_FILE" && -f "$MACHINE_FILE" && -n "$LAYER_CACHE" ]] || return 0
    "$LAYER_SYNC" sync --manifest "$MACHINE_FILE" --cache "$LAYER_CACHE" \
        --schema-version {{ computer_setup_schema_version }}
}

# Any mode that runs the playbook records what it did. `partial` marks a run
# that was narrowed with extra args (`--tags repositories`, `--limit`, …):
# without it `status` would report "no drift" for the WHOLE machine on the
# strength of a run that only ever looked at one role.
#
# The args themselves are deliberately NOT recorded — `-e secret=…` is a
# legitimate invocation, and this file is a report, not a shell history.
state_env() {
    CS_STATE_FILE="$STATE_FILE"
    CS_MANIFEST_FILE="$MANIFEST_FILE"
    CS_HISTORY_FILE="$HISTORY_FILE"
    CS_PROGRESS_FILE="$PROGRESS_FILE"
    # Recorded into the history line, so every run in `history` can be traced to
    # its own log — which is what makes a "recent runs" menu clickable.
    CS_LOG_FILE="$RUN_LOG"
    CS_RUN_MODE="$1"
    CS_RUN_PARTIAL="$2"
    # Identifies this invocation across every play it runs. History is APPENDED,
    # and ansible-pull can reach the callback's final hook more than once, so
    # without a key one run could leave two lines. $$ alone is not enough — the
    # plays may be separate processes — hence the timestamp.
    # CS_RUN_ID is minted by start_run_log, which runs first — see the note
    # there about why the progress marker cannot wait until this point.
    export CS_STATE_FILE CS_MANIFEST_FILE CS_HISTORY_FILE CS_PROGRESS_FILE CS_LOG_FILE
    export CS_RUN_MODE CS_RUN_PARTIAL CS_RUN_ID
}

# ─── Interactive reconcile: stream, don't capture ────────────────────────────
# Shared by apply and check. Runs in the foreground, prints if there is anywhere
# to print to, and ALWAYS writes this run's log.
#
# No longer `exec`: that replaced the shell, so nothing could tee the output or
# run afterwards. Fine while every foreground run had a terminal; not fine now
# that the menu bar launches runs in the background, where exec's output would
# go nowhere and a failure would leave no trace but an exit code nobody sees.
# $1 mode, $2 partial (1 when the CALLER passed extra arguments), rest: the
# ansible-pull arguments.
#
# `partial` is taken as a parameter rather than derived from $# here, because by
# this point the argument list also holds this function's own fixed flags —
# `--check --diff local.yml` and friends — so `$# > 0` is always true and every
# run would mark itself partial. That is not cosmetic: a partial run writes no
# manifest at all, so the inventory would have silently stopped updating.
run_foreground() {
    local mode="$1" partial="$2"; shift 2
    start_run_log "$mode"
    sync_layers || printf '%s\n' "WARN: layer sync failed; continuing with cached content" >&2
    # State is recorded for hand-run modes too, or `status` would describe the
    # 10:00 agent's world rather than the one you just made.
    state_env "$mode" "$partial"

    local rc
    if [[ -t 1 ]]; then
        # Interactive: still streams to the terminal exactly as before, and is
        # kept as well. PIPESTATUS, because tee's exit code is not the run's.
        "$ANSIBLE_PULL" "${ARGS[@]}" "$@" 2>&1 | tee -a "$RUN_LOG"
        rc=${PIPESTATUS[0]}
    else
        "$ANSIBLE_PULL" "${ARGS[@]}" "$@" >> "$RUN_LOG" 2>&1
        rc=$?
    fi

    # A background run has no terminal to complain to, so it says so here. The
    # menu bar and `status` both show the failure regardless; this is for the
    # case where neither is being looked at.
    if [[ $rc -ne 0 && ! -t 1 ]]; then
        notify "computer-setup ${mode} failed" "Exited rc=${rc}. Run \`computer-setup log\`."
    fi
    [[ $rc -eq 0 ]] && prune_logs
    return "$rc"
}

cmd_apply() {
    run_foreground apply "$(( $# > 0 ))" local.yml "$@"
}

# ─── Interactive drift check ─────────────────────────────────────────────────
cmd_check() {
    run_foreground check "$(( $# > 0 ))" -e homebrew_update=false --check --diff local.yml "$@"
}

# ─── Upgrade managed tools, including casks ──────────────────────────────────
# The scheduled 09:00 agent already upgrades formulae, Galaxy and Node. It
# deliberately skips casks: those replace app bundles in /Applications and can
# raise a sudo prompt, which a LaunchAgent has no TTY to answer. This command is
# how casks get upgraded — run it when you're at the keyboard.
#
# Confirmation happens HERE, in your terminal (a guaranteed TTY), rather than via
# an in-play Ansible `pause` — a pause inside `ansible-pull` blocks forever when
# the prompt is missed and silently skips when stdin isn't interactive. This is
# why upgrade stays its own verb instead of being folded into
# `apply --tags upgrade`.
cmd_upgrade() {
    if [[ ! -t 0 ]]; then
        printf '%s\n' "computer-setup upgrade needs a terminal to confirm on." >&2
        printf '%s\n' "The scheduled agent runs the unattended, cask-free upgrade already." >&2
        return 1
    fi
    echo "computer-setup upgrade brings managed tools to their latest versions:"
    echo "  Homebrew formulae + casks, Ansible Galaxy collections, Node LTS."
    echo
    echo "Quit any app being upgraded first — replacing a running app can fail"
    echo "and leave it half-installed."
    printf "Proceed? [y/N]: "
    local reply
    read -r reply
    if [[ "$reply" != [Yy]* ]]; then
        echo "Aborted — nothing changed."
        return 0
    fi
    # Casks that replace files they own (Docker Desktop) need root. Homebrew
    # shells out to sudo, and by then we are several processes deep inside
    # Ansible with pipes for stdin — sudo has no terminal to prompt on, and a
    # credential cached with `sudo -v` out here is not usable in there either.
    #
    # The homebrew_cask module solves this properly: given `sudo_password` it
    # writes a 0700 askpass script and sets SUDO_ASKPASS, which Homebrew turns
    # into `sudo -A`. Collect the password here, where a terminal exists, and
    # hand it over through the environment — not `-e`, which would expose it in
    # the process list.
    local sudo_pw
    echo
    echo "Some casks need root to upgrade (e.g. Docker Desktop)."
    printf "macOS password (Enter to skip those casks): "
    read -rs sudo_pw
    echo
    [[ -n "$sudo_pw" ]] && export CS_SUDO_PASSWORD="$sudo_pw"
    unset sudo_pw

    sync_layers || printf '%s\n' "WARN: layer sync failed; continuing with cached content" >&2
    # Always partial: this runs `--tags upgrade`, so it says nothing about
    # whether the rest of the machine matches its configuration.
    state_env upgrade 1
    "$ANSIBLE_PULL" "${ARGS[@]}" --tags upgrade \
        -e computer_setup_upgrade_assume_yes=true local.yml "$@"
    local rc=$?
    unset CS_SUDO_PASSWORD
    return $rc
}

# ─── Run state ───────────────────────────────────────────────────────────────
# Read one field out of the state file. JSON is valid YAML and yq detects the
# .json extension, so no -p flag; yq is a bootstrap prerequisite, so it is always
# present. Missing file or missing key both yield empty, never an error: state is
# a REPORT, and a machine with no report yet is not a broken machine.
state_field() {
    [[ -f "$STATE_FILE" ]] || return 0
    yq -r "${1} // \"\"" "$STATE_FILE" 2>/dev/null | grep -v '^null$' || true
}

# Whole days since the last successful scheduled run; empty if there has never
# been one. `date -j -f` is BSD date — macOS only, which this whole system is.
days_since_success() {
    [[ -f "$LAST_SUCCESS_FILE" ]] || return 0
    local stamp then_ts now
    stamp="$(tr -d '[:space:]' < "$LAST_SUCCESS_FILE")"
    [[ -n "$stamp" ]] || return 0
    then_ts=$(date -j -f '%Y-%m-%dT%H:%M:%S%z' "$stamp" '+%s' 2>/dev/null) || return 0
    now=$(date '+%s')
    echo $(( (now - then_ts) / 86400 ))
}

# Render the changed/failed task list. `dest` is optional (not every task acts
# on a path), so it is emitted tab-separated and the tab collapsed away here —
# yq is mikefarah's, which has no jq-style `if/then/else` to inline it.
state_task_list() {
    [[ -f "$STATE_FILE" ]] || return 0
    yq -r "${1}[] | \"  - \" + .task + \"\t\" + (.dest // .item // \"\")" "$STATE_FILE" 2>/dev/null \
        | sed -e 's/\t$//' -e 's/\t/  →  /' || true
}

cmd_status() {
    local days changed result mode finished dur
    days="$(days_since_success)"

    if [[ "${1:-}" == "--json" ]]; then
        # Composed rather than echoed: staleness is derived, and a consumer
        # should not have to reimplement the date maths to get it.
        printf '{\n'
        printf '  "last_success": "%s",\n' "$(cat "$LAST_SUCCESS_FILE" 2>/dev/null | tr -d '[:space:]')"
        printf '  "days_since_success": %s,\n' "${days:-null}"
        printf '  "stale": %s,\n' "$( [[ -n "$days" && "$days" -ge "$STALE_AFTER_DAYS" ]] && echo true || echo false )"
        printf '  "last_run": '
        if [[ -f "$STATE_FILE" ]]; then cat "$STATE_FILE"; else printf 'null\n'; fi
        printf '}\n'
        return 0
    fi

    if [[ ! -f "$STATE_FILE" ]]; then
        echo "No run recorded yet. Run \`computer-setup check\` to populate it."
        return 0
    fi

    mode="$(state_field '.mode')"
    result="$(state_field '.result')"
    finished="$(state_field '.finished')"
    dur="$(state_field '.duration_seconds')"
    # The LENGTH of the recorded list, not `.totals.changed`: Ansible counts a
    # looped task once however many items changed, so a task that found three
    # missing credentials would announce "1" and then list three.
    changed="$(state_field '.changed | length')"

    echo "Last run:  ${mode:-?} — ${result:-?} at ${finished:-?}${dur:+ (${dur}s)}"
    # Without this line a tag-limited run reads as a verdict on the whole
    # machine, which is the most misleading thing this file could say.
    if [[ "$(state_field '.partial')" == "true" ]]; then
        echo "           (partial run — only part of the configuration was evaluated)"
    fi

    if [[ "${changed:-0}" -gt 0 ]]; then
        if [[ "$mode" == "check" ]]; then
            echo "Drift:     ${changed} task(s) would change:"
        else
            echo "Changed:   ${changed} task(s):"
        fi
        state_task_list ".changed"
        [[ "$(state_field '.truncated')" == "true" ]] && echo "  … list truncated"
    else
        echo "Drift:     none"
    fi

    local failed_n
    failed_n="$(state_field '.totals.failed')"
    if [[ "${failed_n:-0}" -gt 0 ]]; then
        echo "Failed:    ${failed_n} task(s):"
        state_task_list ".failed"
        echo "           Run \`computer-setup log\` for the detail."
    fi

    # Cheap here, and it is the only place someone looks daily. The detail lives
    # in `computer-setup manifest`; this is just the pointer.
    local orphan_n
    orphan_n="$(yq -r '.orphans // [] | length' "$MANIFEST_FILE" 2>/dev/null || true)"
    if [[ "${orphan_n:-0}" =~ ^[0-9]+$ && "${orphan_n:-0}" -gt 0 ]]; then
        echo "Orphans:   ${orphan_n} path(s) no longer managed but still on disk"
        echo "           See \`computer-setup manifest\`. Nothing is deleted automatically."
    fi

    # The point of the whole file: a machine that silently stopped syncing looks
    # identical to a healthy one until someone asks.
    if [[ -z "$days" ]]; then
        echo "Sync:      no successful scheduled run recorded yet"
    elif [[ "$days" -ge "$STALE_AFTER_DAYS" ]]; then
        echo "Sync:      STALE — last successful scheduled run was ${days} day(s) ago"
    else
        echo "Sync:      ok — last successful scheduled run ${days} day(s) ago"
    fi
}

# ─── What this system owns ───────────────────────────────────────────────────
# The manifest answers "which files are mine", which until now could only be
# reconstructed by reading the roles and resolving them against layer data. It
# is written by the same callback that writes the run state, so it records what
# the run ACTUALLY managed rather than a second hand-maintained list that could
# disagree with it.
cmd_manifest() {
    if [[ ! -f "$MANIFEST_FILE" ]]; then
        echo "No manifest yet. Run \`computer-setup check\` to populate it."
        return 0
    fi
    if [[ "${1:-}" == "--json" ]]; then
        cat "$MANIFEST_FILE"
        return 0
    fi

    local generated n_files n_dirs n_backups n_orphans
    generated="$(yq -r '.generated // ""' "$MANIFEST_FILE" 2>/dev/null)"
    n_files="$(yq -r '.files | length' "$MANIFEST_FILE" 2>/dev/null)"
    n_dirs="$(yq -r '.directories | length' "$MANIFEST_FILE" 2>/dev/null)"
    n_backups="$(yq -r '.backups | length' "$MANIFEST_FILE" 2>/dev/null)"
    n_orphans="$(yq -r '.orphans // [] | length' "$MANIFEST_FILE" 2>/dev/null)"

    # Only a complete run writes this file, so it is always the last full
    # picture — but it may predate the last run, and saying when it was taken is
    # how someone notices they have been running tagged applies all week.
    echo "Recorded:  ${generated:-?}"
    echo
    echo "Files (${n_files:-0}):"
    yq -r '.files[] | "  " + .path + "\t" + (.role // "-")' "$MANIFEST_FILE" 2>/dev/null \
        | column -t -s $'\t' 2>/dev/null || yq -r '.files[].path' "$MANIFEST_FILE"
    echo
    echo "Directories (${n_dirs:-0}):"
    yq -r '.directories[] | "  " + .path' "$MANIFEST_FILE" 2>/dev/null
    # Ansible's `backup: true` residue. Nothing reads these and nothing removes
    # them, so they are listed apart rather than mixed in with live files.
    if [[ "${n_backups:-0}" -gt 0 ]]; then
        echo
        echo "Backup copies left behind (${n_backups}):"
        yq -r '.backups[] | "  " + .path' "$MANIFEST_FILE" 2>/dev/null
    fi
    # Paths this system used to write, still on disk, no longer written by any
    # active capability. REPORTED, never removed — deciding a file is garbage is
    # a judgement, and the evidence is shown so a person can make it.
    if [[ "${n_orphans:-0}" -gt 0 ]]; then
        echo
        echo "No longer managed, still on disk (${n_orphans}):"
        yq -r '.orphans[] | "  " + .path + "\t" + ("was " + (.role // "?")) + "\tsince " + (.since // "?")' \
            "$MANIFEST_FILE" 2>/dev/null | column -t -s $'\t' 2>/dev/null \
            || yq -r '.orphans[].path' "$MANIFEST_FILE" 2>/dev/null
        echo
        echo "  Nothing is deleted automatically. Remove what you recognise."
    fi
}

# ─── Run history ─────────────────────────────────────────────────────────────
# The rolling log holds about three days because it stores full Ansible output.
# This holds most of a year because it stores nine fields, so "when did this
# machine last actually apply anything" stays answerable.
cmd_history() {
    if [[ ! -f "$HISTORY_FILE" ]]; then
        echo "No history yet. It is appended to by every run."
        return 0
    fi
    local n="${1:-20}"
    [[ "$n" =~ ^[0-9]+$ ]] || { printf '%s\n' "history: expected a number, got '$n'" >&2; return 64; }

    # One yq over the whole slice, not one per line: `history 500` would
    # otherwise be 500 process spawns for what is a single read.
    #
    # `partial` is emitted as a plain field and turned into the asterisk by awk.
    # yq here is mikefarah's, which has no jq-style `if/then/else` — see the
    # note in docs/findings.md; this is the second time that has bitten.
    {
        printf '%-26s %-8s %-8s %8s %8s %9s\n' FINISHED MODE RESULT CHANGED FAILED DURATION
        # HISTORY_TSV_EXPR — kept on one line so check.sh can lift it out and
        # run it against a fixture. A broken expression here fails silently
        # (the header still prints, the rows just vanish), which is how the
        # if/then/else version shipped.
        tail -n "$n" "$HISTORY_FILE" \
            | yq -p json -r '[.finished, .mode, .result, (.partial | tostring), (.changed | tostring), (.failed | tostring), (.duration_seconds | tostring)] | @tsv' \
            | awk -F'\t' '{
                mode = $2 ($4 == "true" ? "*" : "")
                printf "%-26s %-8s %-8s %8s %8s %8ss\n", $1, mode, $3, $5, $6, $7
              }'
    }
    echo
    echo "* = partial run (narrowed by tags or arguments)"
}

# ─── Live progress ───────────────────────────────────────────────────────────
# The point is runs you did NOT start: the 09:00 upgrade or the 10:00 check are
# invisible while they happen, and "is it stuck or is it working" had no answer
# short of reading the log afterwards. An interactive run already prints itself.
cmd_progress() {
    if [[ ! -f "$PROGRESS_FILE" ]]; then
        echo "No run has recorded progress yet."
        return 0
    fi
    local head last done_line total current n
    head="$(head -n1 "$PROGRESS_FILE")"
    last="$(tail -n1 "$PROGRESS_FILE")"
    done_line="$(yq -r 'select(.event == "end") | .result' <<<"$last" 2>/dev/null)"

    if [[ -n "$done_line" && "$done_line" != "null" ]]; then
        printf 'Not running. Last run: %s — %s (%s task(s))\n' \
            "$(yq -r '.mode' <<<"$head" 2>/dev/null)" "$done_line" \
            "$(yq -r '.tasks' <<<"$last" 2>/dev/null)"
        return 0
    fi

    if [[ "$(yq -r '.event' <<<"$head" 2>/dev/null)" == "launching" ]]; then
        printf '%s  starting — syncing layers and fetching the orchestrator\n' \
            "$(yq -r '.mode' <<<"$head" 2>/dev/null)"
        return 0
    fi

    total="$(yq -r '.total_estimate // 0' <<<"$head" 2>/dev/null)"
    n="$(yq -r '.n // 0' <<<"$last" 2>/dev/null)"
    current="$(yq -r '.task // ""' <<<"$last" 2>/dev/null)"
    # No end marker does not prove a run is live — it may have been killed. The
    # file's mtime is the only evidence either way, so say which it is rather
    # than animating a bar for a process that died an hour ago.
    local age
    age=$(( $(date +%s) - $(stat -f %m "$PROGRESS_FILE" 2>/dev/null || echo 0) ))
    if [[ "$age" -gt 300 ]]; then
        printf 'Stalled or interrupted — no progress for %sm, stopped at task %s.\n' \
            "$(( age / 60 ))" "${n:-?}"
        printf '  last: %s\n' "$current"
        return 0
    fi

    if [[ "${total:-0}" -gt 0 ]]; then
        local pct filled bar i
        pct=$(( 100 * n / total ))
        # The estimate is the PREVIOUS run of this mode, so this run can
        # legitimately have more tasks. Clamp rather than render past the end.
        [[ "$pct" -gt 100 ]] && pct=100
        filled=$(( pct / 5 ))
        # Built a character at a time. `printf '#%.0s' $(seq 1 0)` looks like it
        # draws nothing and actually draws one — printf reruns its format when
        # given no arguments — so the bar was 21 characters wide at 0%.
        bar=""
        for (( i = 0; i < 20; i++ )); do
            if (( i < filled )); then bar+="#"; else bar+="."; fi
        done
        printf '%s  [%s] %s%%  %s/%s\n' \
            "$(yq -r '.mode' <<<"$head" 2>/dev/null)" \
            "$bar" "$pct" "$n" "$total"
    else
        # First run of a mode has no previous run to size against.
        printf '%s  task %s (no estimate yet — needs one completed run of this mode)\n' \
            "$(yq -r '.mode' <<<"$head" 2>/dev/null)" "$n"
    fi
    printf '  now: %s\n' "$current"
}

# ─── Machine declaration backup ──────────────────────────────────────────────
# Delegated to scripts/computer-setup-machine, not implemented here, because
# bootstrap.sh needs the same operations on a machine where THIS FILE does not
# exist yet: the runner is an Ansible template deployed by the first playbook
# run, and restoring a machine has to happen before that. Same split, and the
# same reason, as computer-setup-layers.
#
# The paths are supplied here so the interactive command needs no arguments; an
# explicit flag still wins, as with `layers`.
cmd_machine() {
    local sub="${1:-}"
    [[ $# -gt 0 ]] && shift
    exec "$MACHINE_SYNC" "$sub" \
        --config "$BACKUP_CONFIG" \
        --repo-dir "$BACKUP_REPO_DIR" \
        --machine-file "$MACHINE_FILE" \
        "$@"
}

# Newest-first list of run logs. A glob and a sort rather than `ls -t`: the
# names are `YYYYmmdd-HHMMSS-<mode>.log`, generated here, so lexical order IS
# chronological order — and shellcheck is right that parsing `ls` is a habit
# worth not having.
run_logs() {
    local -a found=()
    local candidate
    for candidate in "$LOG_DIR"/*.log; do
        [[ -f "$candidate" ]] && found+=("$candidate")
    done
    # Deliberately NOT the shell's array-length form. This file is a Jinja
    # template, and a brace followed by a hash opens a Jinja comment — so that
    # syntax makes the template fail to render entirely, with "Missing end of
    # comment tag". Same reason this comment does not spell it out.
    [[ -z "${found[*]:-}" ]] && return 1
    printf '%s\n' "${found[@]}" | sort -r
}

cmd_log() {
    local logs
    if ! logs="$(run_logs)"; then
        echo "No logs yet in $LOG_DIR"
        return 0
    fi
    if [[ "${1:-}" == "--list" ]]; then
        printf '%s\n' "$logs"
        return 0
    fi
    local latest
    latest="$(printf '%s\n' "$logs" | head -n1)"
    printf '%s\n\n' "── $latest"
    tail -n "${1:-100}" "$latest"
}

# ─── Repository list scaffold ────────────────────────────────────────────────
# Prints a repositories.yml built from the checkouts already on this machine.
# To clone the repos that are MISSING, run `computer-setup apply --tags
# repositories` — the role is gated behind the `never` tag so the scheduled
# agents never clone and bootstrap never touches private repos before SSH auth
# exists. Cloning is non-destructive: existing checkouts are untouched.
cmd_repos() {
    local base="${1:-$REPOS_BASE_DIR}"
    if [[ ! -d "$base" ]]; then
        printf '%s\n' "No such directory: $base" >&2
        return 1
    fi
    echo "---"
    echo "# Generated by \`computer-setup repos\` from ${base} on $(date +%Y-%m-%d)"
    echo "# Review, then save as {{ computer_setup_repositories_override_file }}"
    echo "repositories:"
    local git_dir repo remote
    find "$base" -type d -name .git -prune 2>/dev/null | sort | while read -r git_dir; do
        repo="$(dirname "$git_dir")"
        remote="$(git -C "$repo" remote get-url origin 2>/dev/null)"
        [[ -z "$remote" ]] && continue
        echo "  - folder: \"${repo}\""
        echo "    remote: \"${remote}\""
    done
}

# ─── Scheduled modes (LaunchAgents) ──────────────────────────────────────────
# Logged, notified, and guarded on connectivity. Never interactive.
run_scheduled() {
    local mode="$1"; shift
    start_run_log "$mode"

    {
        echo "──────────────────────────────────────────────────────────"
        echo "${mode} — $(date '+%Y-%m-%d %H:%M:%S %z')"
        echo "──────────────────────────────────────────────────────────"
    } >> "$RUN_LOG"

    # EXPORTED, not scoped to the probe. A command-prefix assignment would apply
    # to `git ls-remote` alone, leaving the layer sync and the ansible-pull free
    # to hit an interactive host-key or passphrase prompt — inside a LaunchAgent
    # with no TTY, that hangs forever. BatchMode makes any such prompt an
    # immediate failure instead.
    export GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=${CONNECTIVITY_TIMEOUT} -o StrictHostKeyChecking=accept-new"

    # Probe the transport we actually use: an SSH git fetch against the real
    # repo. An HTTPS probe passes on networks that allow 443 but block 22
    # (corporate wifi, hotels, captive portals); the pull then fails and fires a
    # "check failed" notification indistinguishable from a real breakage. A
    # closed laptop, a blocked port and an expired key are all "can't work right
    # now", not "your config is broken".
    if ! git ls-remote --exit-code "$REPO_URL" "$REPO_BRANCH" >/dev/null 2>&1; then
        log "RESULT: skipped — ${REPO_URL} unreachable (offline, port 22 blocked, or SSH key unavailable)"
        exit 0
    fi

    sync_layers >> "$RUN_LOG" 2>&1 || log "WARN: layer sync failed; continuing with cached content"

    # check:   -e homebrew_update=false — `state=present` never upgrades, so
    #          refreshing the Homebrew index adds time with zero detection value.
    # upgrade: formulae/Galaxy/Node only; casks need sudo and there's no TTY.
    #
    # BOTH are non-interactive. A LaunchAgent has no terminal and no one
    # watching, so anything that would prompt — a cask's sudo, an `auth login`
    # browser flow — must be reported rather than attempted. It is passed for
    # every scheduled mode rather than only where it is needed today, because
    # the next thing that prompts should be safe by default.
    local -a mode_args=(-e computer_setup_interactive=false)
    if [[ "$mode" == "check" ]]; then
        mode_args+=(-e homebrew_update=false --check --diff)
    else
        mode_args+=(--tags upgrade -e computer_setup_upgrade_assume_yes=true
                    -e computer_setup_upgrade_include_casks=false)
    fi

    local pull_out rc partial=0
    # The scheduled upgrade is `--tags upgrade`, so like the interactive one it
    # is never a statement about the whole machine. The scheduled CHECK is.
    [[ "$mode" == "upgrade" || $# -gt 0 ]] && partial=1
    state_env "$mode" "$partial"
    pull_out=$("$ANSIBLE_PULL" "${ARGS[@]}" "${mode_args[@]}" local.yml "$@" 2>&1)
    rc=$?

    log "$pull_out"

    # Read the count from the state file the callback plugin wrote, NOT from the
    # console output. ansible-pull emits its own checkout play alongside the real
    # one, with [WARNING] lines interleaved between them, so every text-based
    # count has to guess which recap is which. The plugin runs inside the play
    # and simply knows.
    local changed_count
    changed_count=$(state_field '.totals.changed')
    [[ "$changed_count" =~ ^[0-9]+$ ]] || changed_count=0

    if [[ $rc -ne 0 ]]; then
        notify "computer-setup ${mode} failed" "ansible-pull exited rc=$rc. Run \`computer-setup log\`."
        log "RESULT: ansible-pull failed (rc=$rc)"
        exit "$rc"
    fi

    # Only a run that actually reached the repo and finished gets here, which is
    # exactly what "still syncing" means.
    date '+%Y-%m-%dT%H:%M:%S%z' > "$LAST_SUCCESS_FILE" 2>/dev/null || true
    prune_logs

    if [[ "$mode" == "check" ]]; then
        if [[ "$changed_count" -gt 0 ]]; then
            notify "Configuration drift detected" "$changed_count task(s) would change. Run \`computer-setup apply\` to reconcile."
            log "RESULT: drift detected ($changed_count changed task(s))"
        else
            log "RESULT: no drift"
        fi
    else
        if [[ "$changed_count" -gt 0 ]]; then
            notify "Tools upgraded" "$changed_count task(s) changed. Casks not included — run \`computer-setup upgrade\` for those."
            log "RESULT: upgraded ($changed_count changed task(s))"
        else
            log "RESULT: already up to date"
        fi
    fi

    exit 0
}

# `layers sync`/`layers lint` default to the manifest/cache this orchestrator
# already uses everywhere else (see sync_layers() above) — without this, the
# interactive command contradicts its own usage text, which promises "layers
# sync" refreshes the cache with no further arguments. An explicit
# --manifest/--cache on the command line still wins, so overriding for a one-off
# invocation (e.g. linting a manifest that isn't deployed yet) keeps working.
cmd_layers() {
    local sub="${1:-}"
    [[ $# -gt 0 ]] && shift
    local -a args=("$@")

    if [[ "$sub" == "sync" || "$sub" == "lint" ]]; then
        local has_manifest=0 has_cache=0 a
        for a in "${args[@]+"${args[@]}"}"; do
            [[ "$a" == "--manifest" ]] && has_manifest=1
            [[ "$a" == "--cache" ]] && has_cache=1
        done
        [[ $has_cache -eq 0 && -n "$LAYER_CACHE" ]] \
            && args=(--cache "$LAYER_CACHE" "${args[@]+"${args[@]}"}")
        [[ $has_manifest -eq 0 && -f "$MACHINE_FILE" ]] \
            && args=(--manifest "$MACHINE_FILE" "${args[@]+"${args[@]}"}")
    fi

    exec "$LAYER_SYNC" "$sub" "${args[@]+"${args[@]}"}"
}

# ─── Dispatch ────────────────────────────────────────────────────────────────
COMMAND="${1:-}"
shift 2>/dev/null || true

case "$COMMAND" in
    apply)              cmd_apply "$@" ;;
    check)              cmd_check "$@" ;;
    upgrade)            cmd_upgrade "$@" ;;
    log)                cmd_log "$@" ;;
    machine)            cmd_machine "$@" ;;
    status)             cmd_status "$@" ;;
    manifest)           cmd_manifest "$@" ;;
    history)            cmd_history "$@" ;;
    progress)           cmd_progress "$@" ;;
    repos)              cmd_repos "$@" ;;
    capture)            exec "${BIN_DIR}/macos-capture" "$@" ;;
    layers)             cmd_layers "$@" ;;
    _scheduled-check)   run_scheduled check "$@" ;;
    _scheduled-upgrade) run_scheduled upgrade "$@" ;;
    -h|--help|help|"")  usage ;;
    *)
        printf '%s\n' "computer-setup: unknown command '${COMMAND}'" >&2
        printf '\n' >&2
        usage >&2
        exit 64
        ;;
esac
