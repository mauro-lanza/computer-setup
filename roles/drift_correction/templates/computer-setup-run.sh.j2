#!/bin/zsh
# Managed by ansible — do not edit manually
#
# The single entry point for every `ansible-pull` this machine runs.
#
# Previously the pull invocation (prefs file + layer cache + layers manifest
# `-e` flags) was rebuilt independently in three places: bootstrap.sh, the
# `drift-apply` shell function, and the drift-check wrapper. Adding one variable
# meant editing all three. That argument set now lives here, once.
#
# Usage: computer-setup-run <mode> [extra ansible-pull args...]
#
#   apply    Interactive reconcile. Streams to your terminal, no log capture,
#            no notification, no connectivity guard — you can see it fail.
#   check    Scheduled drift detection (--check --diff). Never mutates.
#            Logs, trims, notifies only when drift is found.
#   upgrade  Scheduled upgrade of Homebrew formulae + Galaxy + Node.
#            Casks are EXCLUDED (upgrade_include_casks=false): they replace app
#            bundles in /Applications and can raise a sudo prompt, which is fatal
#            in a LaunchAgent with no TTY. Use `drift-update` to include casks.
#
# Scheduled modes (check/upgrade) exit 0 when the repo is unreachable — see the
# connectivity guard below.

set -uo pipefail

MODE="${1:-}"
shift 2>/dev/null || true

REPO_URL="{{ drift_correction_repo_url }}"
REPO_BRANCH="{{ drift_correction_repo_branch }}"
PREFS_FILE="{{ drift_correction_prefs_file }}"
LAYER_CACHE="{{ drift_correction_layer_cache }}"
LAYERS_FILE="{{ drift_correction_layers_manifest }}"
LOG_FILE="{{ computer_setup_log_file }}"
ANSIBLE_PULL="{{ homebrew_prefix }}/bin/ansible-pull"
LAYER_SYNC="{{ drift_correction_wrapper_dir }}/computer-setup-layers"
MAX_LINES={{ drift_correction_log_max_lines }}
CONNECTIVITY_TIMEOUT={{ drift_correction_connectivity_timeout }}

# ─── The pull argument set — single source of truth ──────────────────────────
ARGS=(-U "$REPO_URL" -C "$REPO_BRANCH")
[[ -f "$PREFS_FILE" ]] && ARGS+=(-e "@${PREFS_FILE}" -e "computer_setup_prefs_file=${PREFS_FILE}")
[[ -n "$LAYER_CACHE" ]] && ARGS+=(-e "computer_setup_layer_cache=${LAYER_CACHE}")
[[ -f "$LAYERS_FILE" ]] && ARGS+=(-e "computer_setup_layers_manifest=${LAYERS_FILE}")

notify() {
    /usr/bin/osascript -e "display notification \"${2}\" with title \"${1}\"" 2>/dev/null || true
}

log() { print -r -- "$@" >> "$LOG_FILE"; }

# ─── Interactive mode: stream, don't capture ─────────────────────────────────
if [[ "$MODE" == "apply" ]]; then
    exec "$ANSIBLE_PULL" "${ARGS[@]}" local.yml "$@"
fi

case "$MODE" in
    check|upgrade) ;;
    *) print -u2 "usage: ${0:t} <apply|check|upgrade> [ansible-pull args...]"; exit 64 ;;
esac

{
    echo
    echo "──────────────────────────────────────────────────────────"
    echo "${MODE} — $(date '+%Y-%m-%d %H:%M:%S %z')"
    echo "──────────────────────────────────────────────────────────"
} >> "$LOG_FILE"

# ─── SSH behaviour for every git operation below ─────────────────────────────
# EXPORTED, not scoped to the probe. A command-prefix assignment would apply to
# `git ls-remote` alone, leaving the layer sync and the ansible-pull itself free
# to hit an interactive "Are you sure you want to continue connecting?" or a key
# passphrase prompt — inside a LaunchAgent with no TTY, that hangs forever.
# BatchMode makes any such prompt an immediate failure instead.
export GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=${CONNECTIVITY_TIMEOUT} -o StrictHostKeyChecking=accept-new"

# ─── Connectivity guard ──────────────────────────────────────────────────────
# Probe the transport we actually use: an SSH git fetch against the real repo.
# The previous guard curled https://github.com, which passes on networks that
# allow 443 but block 22 (corporate wifi, hotels, captive portals) — so the pull
# then failed on SSH and fired a "drift check failed" notification that was
# indistinguishable from a real breakage. A closed laptop, a blocked port and an
# expired key are all "can't work right now", not "your config is broken".
if ! git ls-remote --exit-code "$REPO_URL" "$REPO_BRANCH" >/dev/null 2>&1; then
    log "RESULT: skipped — ${REPO_URL} unreachable (offline, port 22 blocked, or SSH key unavailable)"
    exit 0
fi

# Refresh every content layer so the merge reflects the latest layer content
# (drift covers orchestrator + all layers).
if [[ -n "$LAYERS_FILE" && -f "$LAYERS_FILE" && -n "$LAYER_CACHE" ]]; then
    "$LAYER_SYNC" sync --manifest "$LAYERS_FILE" --cache "$LAYER_CACHE" \
        --schema-version {{ computer_setup_schema_version }} >> "$LOG_FILE" 2>&1 \
        || log "WARN: layer sync failed; continuing with cached content"
fi

# ─── Mode-specific flags ─────────────────────────────────────────────────────
# check:   -e homebrew_update=false — `state=present` never upgrades, so
#          refreshing the Homebrew index adds time with zero detection value.
# upgrade: formulae/Galaxy/Node only; casks need sudo and there's no TTY here.
if [[ "$MODE" == "check" ]]; then
    MODE_ARGS=(-e homebrew_update=false --check --diff)
else
    MODE_ARGS=(--tags upgrade -e upgrade_assume_yes=true -e upgrade_include_casks=false)
fi

PULL_OUT=$("$ANSIBLE_PULL" "${ARGS[@]}" "${MODE_ARGS[@]}" local.yml "$@" 2>&1)
RC=$?

log "$PULL_OUT"

# Trim to the last MAX_LINES lines (prevents unbounded growth, no newsyslog).
if [[ -f "$LOG_FILE" ]]; then
    TMP=$(mktemp)
    tail -n "$MAX_LINES" "$LOG_FILE" > "$TMP" && mv "$TMP" "$LOG_FILE"
fi

# Count `changed=N` from the LAST recap only: ansible-pull emits two PLAY RECAP
# blocks and the first is its own repo checkout (always changed=1).
CHANGED_COUNT=$(echo "$PULL_OUT" | awk '
    /PLAY RECAP/ { in_recap = 1; total = 0; next }
    in_recap && /changed=/ {
        match($0, /changed=[0-9]+/)
        total += substr($0, RSTART+8, RLENGTH-8)
    }
    END { print total+0 }
')

if [[ $RC -ne 0 ]]; then
    notify "computer-setup ${MODE} failed" "ansible-pull exited rc=$RC. Run \`drift-log\`."
    log "RESULT: ansible-pull failed (rc=$RC)"
    exit "$RC"
fi

if [[ "$MODE" == "check" ]]; then
    if [[ "$CHANGED_COUNT" -gt 0 ]]; then
        notify "Configuration drift detected" "$CHANGED_COUNT task(s) would change. Run \`drift-apply\` to reconcile."
        log "RESULT: drift detected ($CHANGED_COUNT changed task(s))"
    else
        log "RESULT: no drift"
    fi
else
    if [[ "$CHANGED_COUNT" -gt 0 ]]; then
        notify "Tools upgraded" "$CHANGED_COUNT task(s) changed. Casks not included — run \`drift-update\` for those."
        log "RESULT: upgraded ($CHANGED_COUNT changed task(s))"
    else
        log "RESULT: already up to date"
    fi
fi

exit 0
