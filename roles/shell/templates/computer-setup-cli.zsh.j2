# Managed by ansible — do not edit manually
#
# computer-setup CLI — the orchestrator's own shell commands. This snippet is
# engine-owned (it operates computer-setup itself) and is deployed by the shell
# role regardless of which content layers are active.

# ─── Drift correction helpers ─────────────────────────────────────────────────
# `drift-check`  → run the same check the LaunchAgent runs (no changes applied)
# `drift-apply`  → reconcile drift by applying the playbook
# `drift-log`    → tail the rolling drift log
drift-check() {
    "$HOME/.local/bin/drift-check" "$@"
    local rc=$?
    [[ $rc -eq 0 ]] && echo "drift-check finished — see $HOME/Library/Logs/ansible-drift-correction.log"
    return $rc
}

drift-apply() {
    local prefs="{{ computer_setup_prefs_file }}"
    local plugin_cache="{{ computer_setup_plugin_cache }}"
    local layers_manifest="{{ computer_setup_layers_manifest }}"
    local args=()
    [[ -f "$prefs" ]] && args+=(-e "@${prefs}" -e "computer_setup_prefs_file=${prefs}")
    [[ -n "$plugin_cache" ]] && args+=(-e "computer_setup_plugin_cache=${plugin_cache}")
    [[ -f "$layers_manifest" ]] && args+=(-e "computer_setup_layers_manifest=${layers_manifest}")
    ansible-pull -U "{{ repo_url }}" -C "{{ repo_branch }}" "${args[@]}" local.yml "$@"
}

# Upgrade managed tools to their latest versions (brew formulae/casks, Ansible
# Galaxy collections, node LTS). Opt-in: the daily drift check never runs these
# — they're gated behind the `upgrade`/`never` tags.
#
# Confirmation happens here, in your terminal (a guaranteed TTY), rather than via
# an in-play Ansible `pause` — a pause inside `ansible-pull` blocks forever when
# the prompt is missed and silently skips when stdin isn't interactive. After you
# confirm, ansible-pull runs fully non-interactively with upgrade_assume_yes=true.
drift-update() {
    echo "drift-update upgrades managed tools to their latest versions:"
    echo "  Homebrew formulae + casks, Ansible Galaxy collections, Node LTS."
    printf "Proceed? [y/N]: "
    local reply
    read -r reply
    if [[ "$reply" != [Yy]* ]]; then
        echo "Aborted — nothing changed."
        return 0
    fi
    drift-apply --tags upgrade -e upgrade_assume_yes=true "$@"
}

drift-log() {
    local log="$HOME/Library/Logs/ansible-drift-correction.log"
    [[ -f "$log" ]] && tail -n "${1:-100}" "$log" || echo "No drift log yet at $log"
}

# ─── Repository catalog helpers ─────────────────────────────────────────────────
# `repos-resurrect`  → clone any catalogued repos that are missing
# `repos-generate`   → scaffold a catalog from the repos already on this machine
#
# Opt-in: the `repositories` role is gated behind the `never` tag, so the daily
# drift check never clones repos and bootstrap won't touch (possibly private)
# repos before SSH auth exists. Run `repos-resurrect` yourself after
# `gh auth login`. Cloning is non-destructive — existing checkouts are untouched.
repos-resurrect() {
    drift-apply --tags repositories "$@"
}

repos-generate() {
    local base="${1:-${PROJECTS_BASE_DIR:-$HOME/Projects}}"
    if [[ ! -d "$base" ]]; then
        echo "No such directory: $base" >&2
        return 1
    fi
    echo "---"
    echo "# Generated by repos-generate from ${base} on $(date +%Y-%m-%d)"
    echo "# Review, then save as ~/.repositories.yml"
    echo "repositories:"
    local git_dir repo remote
    find "$base" -type d -name .git -prune 2>/dev/null | sort | while read -r git_dir; do
        repo="${git_dir:h}"
        remote="$(git -C "$repo" remote get-url origin 2>/dev/null)"
        [[ -z "$remote" ]] && continue
        echo "  - folder: \"${repo}\""
        echo "    remote: \"${remote}\""
    done
}
