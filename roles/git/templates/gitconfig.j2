# Managed by computer-setup — do not edit manually.
# Source of truth: roles/git (defaults/main.yml + templates/gitconfig.j2).
# Any manual changes here are overwritten on the next playbook run.
#
# This file is INCLUDED from ~/.gitconfig; edit that file for anything you want
# to keep. The include is appended there, so these values are read last and win.
{% if (git_user_name | length > 0) or (git_user_email | length > 0) %}
[user]
{% if git_user_name | length > 0 %}
	name = {{ git_user_name }}
{% endif %}
{% if git_user_email | length > 0 %}
	email = {{ git_user_email }}
{% endif %}
{% endif %}
{% if git_default_branch | length > 0 %}
[init]
	defaultBranch = {{ git_default_branch }}
{% endif %}
{# An unset editor means "respect $EDITOR/$VISUAL" — writing core.editor       #}
{# unconditionally would silently override it. Only claim core.excludesFile   #}
{# when this role actually manages that file, otherwise git is pointed at a   #}
{# path the role deliberately left alone. With neither, [core] is omitted     #}
{# entirely rather than emitted as an empty section.                          #}
{% set _has_excludes = (git_global_gitignore_entries | default([], true) | length > 0) %}
{% if (git_editor_resolved | length > 0) or _has_excludes %}
[core]
{% if git_editor_resolved | length > 0 %}
	editor = {{ git_editor_resolved }}
{% endif %}
{% if _has_excludes %}
	excludesFile = {{ home_dir }}/.gitignore_global
{% endif %}
{% endif %}
{% for section, entries in git_config_sections.items() %}
[{{ section }}]
{% for key, value in entries.items() %}
	{{ key }} = {{ value }}
{% endfor %}
{% endfor %}
{% for identity in git_conditional_identities | default([], true) %}
{# Rendered last on purpose: an includeIf must come after the global [user]  #}
{# block it is meant to override, or git keeps the global identity.          #}
[includeIf "{{ identity.condition }}"]
	path = {{ git_managed_config_dir }}/identity-{{ identity.condition | hash('md5') }}.gitconfig
{% endfor %}
