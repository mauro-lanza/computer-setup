<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Managed by ansible — do not edit manually.
  One plist per wanted agent, from `scheduled_agents_engine` (the engine's own
  drift/upgrade jobs) and `scheduled_agents` (layer-contributed). This template
  knows nothing about any specific tool, including the engine's.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{ agent.label }}</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{ agent.program }}</string>
{% for arg in agent.args | default([]) %}
        <string>{{ arg }}</string>
{% endfor %}
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>{{ agent.hour | int }}</integer>
        <key>Minute</key>
        <integer>{{ agent.minute | int }}</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>{{ scheduled_agents_log_dir }}/{{ agent.label }}.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>{{ scheduled_agents_log_dir }}/{{ agent.label }}.stderr.log</string>

    <!--
      LaunchAgents inherit no login-shell environment, so PATH is set
      explicitly. Without it a job cannot find `git`, `gh`, or anything else
      from Homebrew, and fails in a way that only shows up in the stderr log.
    -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{{ homebrew_prefix }}/bin:{{ homebrew_prefix }}/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>{{ home_dir }}</string>
    </dict>
</dict>
</plist>
