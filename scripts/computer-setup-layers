#!/bin/bash
set -euo pipefail

PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"

usage() {
    cat <<'EOF'
Usage:
  computer-setup-layers sync --manifest PATH --cache DIR [--schema-version N]
  computer-setup-layers lint (--cache DIR | --layer DIR)

sync  Synchronize content layers from a manifest into the layer cache. Repo URLs
      are used as written; a scheme-less github.com:owner/repo becomes SSH.

lint  Check that a layer's cross-references resolve. Capabilities, questions and
      presets refer to each other by id, and every one of those references fails
      SILENTLY when it is wrong: a preset naming a capability that does not exist
      selects nothing, and an `implies:` naming one installs nothing. --cache
      lints the whole merged set (ids resolve across layers, as at runtime);
      --layer lints one directory on its own.
EOF
}

log() { printf '%s\n' "$*"; }
warn() { printf 'WARN: %s\n' "$*" >&2; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

# Normalize a manifest repo URL. A scheme-less `github.com:owner/repo` is
# completed to SSH — it is not a usable URL as written, so there is no intent to
# override. An explicit https:// URL is LEFT ALONE: rewriting it to SSH silently
# overrode the operator, and broke exactly the case bootstrap itself warns about
# (port 22 blocked, corporate proxy), where https is the deliberate choice.
normalize_repo_url() {
    local repo="$1"
    case "$repo" in
        github.com:*) printf 'git@%s\n' "$repo" ;;
        *) printf '%s\n' "$repo" ;;
    esac
}

validate_layer() {
    local name="$1" dest="$2" schema_version_max="$3"
    [[ -f "$dest/layer.yml" ]] || die "Layer '$name' is missing layer.yml"

    local layer_name sv
    layer_name="$(yq -r '.name // ""' "$dest/layer.yml")"
    [[ "$layer_name" == "$name" ]] || die "Layer '$name' layer.yml name is '$layer_name'"

    sv="$(yq -r '.schema_version // 1' "$dest/layer.yml")"
    # Must be a plain integer. Bash arithmetic aborts on anything else — with
    # `schema_version: 2.0` the `((` throws a syntax error to stderr, the test
    # evaluates false, and the layer is ACCEPTED here while the playbook's own
    # check (`| int` = 2) rejects it mid-run. Validate the shape, then compare.
    [[ "$sv" =~ ^[0-9]+$ ]] \
        || die "Layer '$name' has a non-integer schema_version: '${sv}'"
    if (( sv > schema_version_max )); then
        die "Layer '$name' requires schema_version ${sv}, but this orchestrator supports up to ${schema_version_max}"
    fi
}

validate_manifest_entry() {
    local manifest="$1" index="$2" seen_names="$3"
    local name repo priority

    name="$(yq -r ".layers[$index].name // \"\"" "$manifest")"
    repo="$(yq -r ".layers[$index].repo // \"\"" "$manifest")"
    priority="$(yq -r ".layers[$index].priority // \"\"" "$manifest")"

    [[ -n "$name" ]] || die "Layer entry $index is missing name"
    # The name becomes a path segment ("$cache/$name") and is interpolated into
    # Ansible paths, so restrict it to a safe token. Without this, `../../.ssh`
    # clones a repo over an arbitrary directory, and a name containing spaces
    # silently word-splits in bootstrap's capability loader.
    [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] \
        || die "Layer name '$name' is invalid — use letters, digits, '.', '_', '-' (must not start with '.' or '-')"
    [[ "$name" != *".."* ]] || die "Layer name '$name' must not contain '..'"
    [[ -n "$repo" ]] || die "Layer '$name' is missing repo"
    [[ "$priority" =~ ^[0-9]+$ ]] || die "Layer '$name' priority must be a number"
    [[ "$seen_names" != *" $name "* ]] || die "Duplicate layer name in manifest: $name"
}

sync_layers() {
    # Default duplicated from local.yml's computer_setup_schema_version;
    # scripts/check.sh asserts they agree. Normally passed in with --schema-version.
    local manifest="" cache="" schema_version_max=1
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --manifest) manifest="$2"; shift 2 ;;
            --cache) cache="$2"; shift 2 ;;
            --schema-version) schema_version_max="$2"; shift 2 ;;
            -h|--help) usage; exit 0 ;;
            *) die "Unknown argument: $1" ;;
        esac
    done

    [[ -n "$manifest" ]] || die "--manifest is required"
    [[ -n "$cache" ]] || die "--cache is required"
    [[ -f "$manifest" ]] || die "Layer manifest does not exist: $manifest"

    local n
    n="$(yq -r '.layers | length' "$manifest")"
    if [[ "$n" -eq 0 ]]; then
        warn "No layers to sync"
        return 0
    fi

    mkdir -p "$cache"

    local i name repo dest branch seen_names=" "
    for ((i = 0; i < n; i++)); do
        validate_manifest_entry "$manifest" "$i" "$seen_names"
        name="$(yq -r ".layers[$i].name" "$manifest")"
        seen_names="${seen_names}${name} "
        repo="$(normalize_repo_url "$(yq -r ".layers[$i].repo" "$manifest")")"
        dest="$cache/$name"

        # The layer cache is a CACHE, not a working copy — nothing is ever
        # authored here, so the only correct end state is "byte-identical to
        # origin". Fetch and hard-reset unconditionally rather than `pull`:
        #
        #   * `git pull --ff-only` returns SUCCESS when the cache is AHEAD of
        #     origin ("Already up to date" — there is nothing to fast-forward),
        #     so a stray local commit in the cache survived every single sync.
        #     The daily drift check then reported "no drift" while running
        #     against modified layer content — the exact failure this code was
        #     written to prevent, for the one case it did not cover.
        #   * `pull` honours ambient config. The managed ~/.gitconfig sets
        #     pull.rebase=true, so cache maintenance silently depended on the
        #     user's global git settings.
        #
        # fetch + reset + clean treats ahead, behind, diverged, force-pushed and
        # dirty identically, and is a cheap no-op when already in sync.
        if [[ -d "$dest/.git" ]]; then
            log "Updating layer '$name'..."
            git -C "$dest" remote set-url origin "$repo" \
                || die "Layer '$name': could not set origin to $repo"

            branch="$(git -C "$dest" symbolic-ref --short HEAD 2>/dev/null || true)"
            if [[ -z "$branch" ]]; then
                # Detached HEAD: there is no branch to track. Re-cloning is
                # cheap and unambiguously correct for a cache.
                warn "Layer '$name': cache HEAD is detached — re-cloning"
                rm -rf "$dest"
                git clone --depth 1 "$repo" "$dest"
            else
                # Explicit refspec: without it `git fetch origin <branch>` may
                # only write FETCH_HEAD, leaving refs/remotes/origin/<branch>
                # stale — and the reset below would then "succeed" onto the old
                # commit, i.e. never update the layer at all.
                git -C "$dest" fetch --depth 1 origin \
                    "+refs/heads/${branch}:refs/remotes/origin/${branch}" \
                    || die "Layer '$name': fetch failed — cache is stale and cannot be repaired. Remove $dest and re-run."
                git -C "$dest" reset --hard "refs/remotes/origin/${branch}" >/dev/null \
                    || die "Layer '$name': reset failed. Remove $dest and re-run."
                # -ffd also clears nested checkouts a stray clone may have left.
                git -C "$dest" clean -ffd >/dev/null 2>&1 || true
            fi
        else
            # A non-git directory here means an interrupted clone or a stray
            # path; `git clone` would abort the whole sync with "destination
            # path already exists". Clear it and start clean.
            if [[ -e "$dest" ]]; then
                warn "Layer '$name': '$dest' exists but is not a git checkout — replacing it"
                rm -rf "$dest"
            fi
            log "Cloning layer '$name' from $repo..."
            git clone --depth 1 "$repo" "$dest"
        fi

        validate_layer "$name" "$dest" "$schema_version_max"
    done
}

# ─── lint ────────────────────────────────────────────────────────────────────
# Capabilities, questions and presets reference each other by id, and EVERY one
# of those references degrades silently when wrong: bootstrap matches the id
# against the merged registry, finds nothing, and moves on. A typo in a preset
# is invisible until you notice a tool was never installed.
#
# Ids resolve across ALL layers at runtime (the registries are merged before
# anything is read), so --cache lints the merged set. --layer lints one
# directory as its own universe, which is what the example layer and the test
# fixtures need.

lint_fail_count=0
lint_note_count=0
lint_err()  { printf '  ERROR: %s\n' "$*" >&2; lint_fail_count=$((lint_fail_count + 1)); }
lint_note() { printf '  note:  %s\n' "$*"; lint_note_count=$((lint_note_count + 1)); }

# An unresolved id is only DEFINITELY wrong when the whole merged set is in
# view. Linting one directory cannot know whether a sibling layer declares it —
# cross-layer references are legal and normal (an extension capability in one
# layer requiring the editor cask from another). So --cache errors and --layer
# only notes.
LINT_SCOPE="cache"
lint_ref_problem() {
    if [[ "$LINT_SCOPE" == "cache" ]]; then
        lint_err "$*"
    else
        lint_note "$* (unresolved here; may resolve against another layer)"
    fi
}

# Emit a yq projection over a file, or nothing when the file is absent/invalid.
# A malformed file is reported once, here, rather than yielding a confusing
# cascade of "reference does not resolve" errors.
lint_read() {
    local file="$1" expr="$2"
    [[ -f "$file" ]] || return 0
    if ! yq '.' "$file" >/dev/null 2>&1; then
        lint_err "$(basename "$(dirname "$file")")/$(basename "$file") is not valid YAML"
        return 0
    fi
    yq -r "$expr" "$file" 2>/dev/null | grep -v '^null$' || true
}

lint_has()   { printf '%s\n' "$2" | grep -qxF -- "$1"; }
lint_count() { printf '%s\n' "$1" | grep -cv '^$' || true; }

lint_layers() {
    local cache="" single=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --cache) cache="$2"; shift 2 ;;
            --layer) single="$2"; shift 2 ;;
            --manifest) shift 2 ;;   # accepted and ignored: lint reads the cache
            -h|--help) usage; exit 0 ;;
            *) die "Unknown argument: $1" ;;
        esac
    done

    local -a dirs=()
    if [[ -n "$single" ]]; then
        [[ -d "$single" ]] || die "No such layer directory: $single"
        dirs=("$single")
        LINT_SCOPE="layer"
    elif [[ -n "$cache" ]]; then
        [[ -d "$cache" ]] || die "No such layer cache: $cache"
        local d
        for d in "$cache"/*/; do
            [[ -f "${d}layer.yml" ]] && dirs+=("${d%/}")
        done
        [[ ${#dirs[@]} -gt 0 ]] || die "No layers found in $cache"
    else
        die "lint needs --cache DIR or --layer DIR"
    fi

    # ── Universe of ids, merged across every layer being linted ──────────────
    # Duplicates ACROSS layers are legal and are the override mechanism: a
    # higher-priority layer redeclares an id to replace it wholesale (the
    # personal layer does exactly this to pre-fill the git identity questions).
    # Only a duplicate WITHIN one layer is a bug, since the two entries silently
    # collapse to whichever the merge reaches last.
    local all_caps="" all_questions="" all_preset_caps="" d ids dupes name
    for d in "${dirs[@]}"; do
        name="$(basename "$d")"

        ids="$(lint_read "$d/capabilities.yml" '.capabilities[]?.id')"
        dupes="$(printf '%s\n' "$ids" | grep -v '^$' | sort | uniq -d || true)"
        [[ -n "$dupes" ]] && lint_err "[$name] capability id declared twice in this layer: $(printf '%s' "$dupes" | tr '\n' ' ')"
        all_caps+="$ids"$'\n'

        ids="$(lint_read "$d/questions.yml" '.questions[]?.id')"
        dupes="$(printf '%s\n' "$ids" | grep -v '^$' | sort | uniq -d || true)"
        [[ -n "$dupes" ]] && lint_err "[$name] question id declared twice in this layer: $(printf '%s' "$dupes" | tr '\n' ' ')"
        all_questions+="$ids"$'\n'

        all_preset_caps+="$(lint_read "$d/presets.yml" '.presets[]?.capabilities[]?')"$'\n'
    done
    all_caps="$(printf '%s' "$all_caps" | grep -v '^$' || true)"
    all_questions="$(printf '%s' "$all_questions" | grep -v '^$' || true)"
    all_preset_caps="$(printf '%s' "$all_preset_caps" | grep -v '^$' || true)"

    for d in "${dirs[@]}"; do
        local ref
        name="$(basename "$d")"

        # capability.requires -> a real capability
        while IFS= read -r ref; do
            [[ -z "$ref" ]] && continue
            lint_has "$ref" "$all_caps" \
                || lint_ref_problem "[$name] capability requires '$ref', which no layer declares"
        done <<< "$(lint_read "$d/capabilities.yml" '.capabilities[]? | select(.requires) | .requires')"

        # type: extension must name the manager that installs it
        while IFS= read -r ref; do
            [[ -z "$ref" ]] && continue
            lint_err "[$name] capability '$ref' is type: extension but declares no manager:"
        done <<< "$(lint_read "$d/capabilities.yml" '.capabilities[]? | select(.type == "extension") | select(has("manager") | not) | .id')"

        # A package named owner/tap/formula is unresolvable until its tap is
        # added. Declaring the tap is the ONLY way the engine can know; without
        # it the capability installs fine on a machine where someone once ran
        # `brew tap` by hand, and fails on every fresh one. Always an error --
        # unlike a cross-layer id, a missing tap cannot be supplied elsewhere.
        while IFS= read -r ref; do
            [[ -z "$ref" ]] && continue
            lint_err "[$name] capability '$ref' names a tapped package but declares no tap:"
        done <<< "$(lint_read "$d/capabilities.yml" '.capabilities[]? | select(.packages) | select(.packages | test("[^ /]+/[^ /]+/[^ /]+")) | select(has("tap") | not) | .id')"

        # preset.capabilities -> a real capability
        while IFS= read -r ref; do
            [[ -z "$ref" ]] && continue
            lint_has "$ref" "$all_caps" \
                || lint_ref_problem "[$name] preset selects capability '$ref', which no layer declares"
        done <<< "$(lint_read "$d/presets.yml" '.presets[]?.capabilities[]?')"

        # preset.answers -> a real question
        while IFS= read -r ref; do
            [[ -z "$ref" ]] && continue
            lint_has "$ref" "$all_questions" \
                || lint_ref_problem "[$name] preset answers question '$ref', which no layer declares"
        done <<< "$(lint_read "$d/presets.yml" '.presets[]?.answers? | select(. != null) | keys | .[]')"

        # question option implies -> a real capability
        while IFS= read -r ref; do
            [[ -z "$ref" ]] && continue
            lint_has "$ref" "$all_caps" \
                || lint_ref_problem "[$name] question implies capability '$ref', which no layer declares"
        done <<< "$(lint_read "$d/questions.yml" '.questions[]?.options[]?.implies[]?')"
    done

    # Report, not an error: presets are curated, so a capability outside every
    # preset is usually deliberate. Worth seeing when you add one.
    local uncovered
    uncovered="$(comm -23 <(printf '%s\n' "$all_caps" | sort -u | grep -v '^$') \
                          <(printf '%s\n' "$all_preset_caps" | sort -u | grep -v '^$') || true)"
    if [[ -n "$uncovered" ]]; then
        printf '  note:  %s capability(ies) in no preset: %s\n' \
            "$(lint_count "$uncovered")" "$(printf '%s' "$uncovered" | tr '\n' ' ')"
    fi

    if [[ "$lint_fail_count" -gt 0 ]]; then
        printf 'ERROR: %s cross-reference problem(s)\n' "$lint_fail_count" >&2
        exit 1
    fi
    log "  ok  $(lint_count "$all_caps") capabilities, $(lint_count "$all_questions") questions: all references resolve"
}

main() {
    local command="${1:-}"
    shift || true
    case "$command" in
        sync) sync_layers "$@" ;;
        lint) lint_layers "$@" ;;
        -h|--help|"") usage ;;
        *) die "Unknown command: $command" ;;
    esac
}

main "$@"
