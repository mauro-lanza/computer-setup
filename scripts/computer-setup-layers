#!/bin/bash
set -euo pipefail

PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"

usage() {
    cat <<'EOF'
Usage: computer-setup-layers sync --manifest PATH --cache DIR [--schema-version N]

Synchronize content layers from a manifest into the layer cache. Repo URLs are
used as written; a scheme-less github.com:owner/repo is completed to SSH.
EOF
}

log() { printf '%s\n' "$*"; }
warn() { printf 'WARN: %s\n' "$*" >&2; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

# Normalize a manifest repo URL. A scheme-less `github.com:owner/repo` is
# completed to SSH — it is not a usable URL as written, so there is no intent to
# override. An explicit https:// URL is LEFT ALONE: rewriting it to SSH silently
# overrode the operator, and broke exactly the case bootstrap itself warns about
# (port 22 blocked, corporate proxy), where https is the deliberate choice.
normalize_repo_url() {
    local repo="$1"
    case "$repo" in
        github.com:*) printf 'git@%s\n' "$repo" ;;
        *) printf '%s\n' "$repo" ;;
    esac
}

validate_layer() {
    local name="$1" dest="$2" schema_version_max="$3"
    [[ -f "$dest/layer.yml" ]] || die "Layer '$name' is missing layer.yml"

    local layer_name sv
    layer_name="$(yq -r '.name // ""' "$dest/layer.yml")"
    [[ "$layer_name" == "$name" ]] || die "Layer '$name' layer.yml name is '$layer_name'"

    sv="$(yq -r '.schema_version // 1' "$dest/layer.yml")"
    # Must be a plain integer. Bash arithmetic aborts on anything else — with
    # `schema_version: 2.0` the `((` throws a syntax error to stderr, the test
    # evaluates false, and the layer is ACCEPTED here while the playbook's own
    # check (`| int` = 2) rejects it mid-run. Validate the shape, then compare.
    [[ "$sv" =~ ^[0-9]+$ ]] \
        || die "Layer '$name' has a non-integer schema_version: '${sv}'"
    if (( sv > schema_version_max )); then
        die "Layer '$name' requires schema_version ${sv}, but this orchestrator supports up to ${schema_version_max}"
    fi
}

validate_manifest_entry() {
    local manifest="$1" index="$2" seen_names="$3"
    local name repo priority

    name="$(yq -r ".layers[$index].name // \"\"" "$manifest")"
    repo="$(yq -r ".layers[$index].repo // \"\"" "$manifest")"
    priority="$(yq -r ".layers[$index].priority // \"\"" "$manifest")"

    [[ -n "$name" ]] || die "Layer entry $index is missing name"
    # The name becomes a path segment ("$cache/$name") and is interpolated into
    # Ansible paths, so restrict it to a safe token. Without this, `../../.ssh`
    # clones a repo over an arbitrary directory, and a name containing spaces
    # silently word-splits in bootstrap's capability loader.
    [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] \
        || die "Layer name '$name' is invalid — use letters, digits, '.', '_', '-' (must not start with '.' or '-')"
    [[ "$name" != *".."* ]] || die "Layer name '$name' must not contain '..'"
    [[ -n "$repo" ]] || die "Layer '$name' is missing repo"
    [[ "$priority" =~ ^[0-9]+$ ]] || die "Layer '$name' priority must be a number"
    [[ "$seen_names" != *" $name "* ]] || die "Duplicate layer name in manifest: $name"
}

sync_layers() {
    local manifest="" cache="" schema_version_max=1
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --manifest) manifest="$2"; shift 2 ;;
            --cache) cache="$2"; shift 2 ;;
            --schema-version) schema_version_max="$2"; shift 2 ;;
            -h|--help) usage; exit 0 ;;
            *) die "Unknown argument: $1" ;;
        esac
    done

    [[ -n "$manifest" ]] || die "--manifest is required"
    [[ -n "$cache" ]] || die "--cache is required"
    [[ -f "$manifest" ]] || die "Layer manifest does not exist: $manifest"

    local n
    n="$(yq -r '.layers | length' "$manifest")"
    if [[ "$n" -eq 0 ]]; then
        warn "No layers to sync"
        return 0
    fi

    mkdir -p "$cache"

    local i name repo dest branch seen_names=" "
    for ((i = 0; i < n; i++)); do
        validate_manifest_entry "$manifest" "$i" "$seen_names"
        name="$(yq -r ".layers[$i].name" "$manifest")"
        seen_names="${seen_names}${name} "
        repo="$(normalize_repo_url "$(yq -r ".layers[$i].repo" "$manifest")")"
        dest="$cache/$name"

        # The layer cache is a CACHE, not a working copy — nothing is ever
        # authored here, so the only correct end state is "byte-identical to
        # origin". Fetch and hard-reset unconditionally rather than `pull`:
        #
        #   * `git pull --ff-only` returns SUCCESS when the cache is AHEAD of
        #     origin ("Already up to date" — there is nothing to fast-forward),
        #     so a stray local commit in the cache survived every single sync.
        #     The daily drift check then reported "no drift" while running
        #     against modified layer content — the exact failure this code was
        #     written to prevent, for the one case it did not cover.
        #   * `pull` honours ambient config. The managed ~/.gitconfig sets
        #     pull.rebase=true, so cache maintenance silently depended on the
        #     user's global git settings.
        #
        # fetch + reset + clean treats ahead, behind, diverged, force-pushed and
        # dirty identically, and is a cheap no-op when already in sync.
        if [[ -d "$dest/.git" ]]; then
            log "Updating layer '$name'..."
            git -C "$dest" remote set-url origin "$repo" \
                || die "Layer '$name': could not set origin to $repo"

            branch="$(git -C "$dest" symbolic-ref --short HEAD 2>/dev/null || true)"
            if [[ -z "$branch" ]]; then
                # Detached HEAD: there is no branch to track. Re-cloning is
                # cheap and unambiguously correct for a cache.
                warn "Layer '$name': cache HEAD is detached — re-cloning"
                rm -rf "$dest"
                git clone --depth 1 "$repo" "$dest"
            else
                # Explicit refspec: without it `git fetch origin <branch>` may
                # only write FETCH_HEAD, leaving refs/remotes/origin/<branch>
                # stale — and the reset below would then "succeed" onto the old
                # commit, i.e. never update the layer at all.
                git -C "$dest" fetch --depth 1 origin \
                    "+refs/heads/${branch}:refs/remotes/origin/${branch}" \
                    || die "Layer '$name': fetch failed — cache is stale and cannot be repaired. Remove $dest and re-run."
                git -C "$dest" reset --hard "refs/remotes/origin/${branch}" >/dev/null \
                    || die "Layer '$name': reset failed. Remove $dest and re-run."
                # -ffd also clears nested checkouts a stray clone may have left.
                git -C "$dest" clean -ffd >/dev/null 2>&1 || true
            fi
        else
            # A non-git directory here means an interrupted clone or a stray
            # path; `git clone` would abort the whole sync with "destination
            # path already exists". Clear it and start clean.
            if [[ -e "$dest" ]]; then
                warn "Layer '$name': '$dest' exists but is not a git checkout — replacing it"
                rm -rf "$dest"
            fi
            log "Cloning layer '$name' from $repo..."
            git clone --depth 1 "$repo" "$dest"
        fi

        validate_layer "$name" "$dest" "$schema_version_max"
    done
}

main() {
    local command="${1:-}"
    shift || true
    case "$command" in
        sync) sync_layers "$@" ;;
        -h|--help|"") usage ;;
        *) die "Unknown command: $command" ;;
    esac
}

main "$@"
