#!/bin/bash
set -euo pipefail

# computer-setup manager registry tool.
#
#   scripts/managers            Validate all manifests and verify docs/managers.md
#                               is up to date (used by scripts/check.sh).
#   scripts/managers generate   Validate and (re)write docs/managers.md.
#
# A manager is an engine role with a roles/<name>/meta/manager.yml manifest:
#   manager: { name, tier: generic|specific|engine, summary, capabilities[], consumes[] }
# This is metadata only — discovery, docs, and validation. Managers still run as
# ordinary roles in local.yml; nothing here dispatches them at runtime.

cd "$(dirname "$0")/.."

DOC="docs/managers.md"

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

# Print sorted table rows, tolerating an empty set. macOS ships bash 3.2, where
# expanding an empty array as "${arr[@]}" under `set -u` is an "unbound
# variable" fatal — so the moment a tier had no managers, this tool would die
# instead of rendering an empty section. Taking the rows as positional
# arguments (guarded at the call site) sidesteps the array-expansion rule
# entirely, and `printf` with no rows would otherwise emit a bogus blank line.
emit_rows() {
    [[ $# -eq 0 ]] && return 0
    printf '%s\n' "$@" | sort
}

validate_and_render() {
    local meta role name tier summary caps consumes
    local -a generic=() specific=() engine=()

    for meta in roles/*/meta/manager.yml; do
        [[ -f "$meta" ]] || continue
        role="$(basename "$(dirname "$(dirname "$meta")")")"
        yq '.' "$meta" >/dev/null 2>&1 || die "$meta is not valid YAML"

        name="$(yq -r '.manager.name // ""' "$meta")"
        tier="$(yq -r '.manager.tier // ""' "$meta")"
        summary="$(yq -r '.manager.summary // "" | sub("\n"; " ") | sub(" +$"; "")' "$meta")"
        caps="$(yq -r '.manager.capabilities // [] | join(", ")' "$meta")"
        consumes="$(yq -r '.manager.consumes // [] | join(", ")' "$meta")"

        [[ -n "$name" ]]    || die "$meta: manager.name is required"
        [[ "$name" == "$role" ]] || die "$meta: manager.name '$name' must match role dir '$role'"
        [[ -n "$summary" ]] || die "$meta: manager.summary is required"
        case "$tier" in
            generic|specific|engine) ;;
            *) die "$meta: manager.tier must be generic|specific|engine (got '$tier')" ;;
        esac
        [[ "$tier" == "specific" && -z "$caps" ]] && \
            die "$meta: a specific manager must list the capabilities it services"
        [[ "$tier" != "specific" && -n "$caps" ]] && \
            die "$meta: only specific managers declare capabilities (got '$caps')"

        local row="| \`$name\` | ${caps:-—} | $summary |"
        case "$tier" in
            generic)  generic+=("$row") ;;
            specific) specific+=("$row") ;;
            engine)   engine+=("$row") ;;
        esac
    done

    {
        echo "# Manager registry"
        echo
        echo "> Generated by \`scripts/managers generate\` from each role's"
        echo "> \`meta/manager.yml\`. Do not edit by hand."
        echo
        echo "Managers are the engine's building blocks. Plugins supply *data*;"
        echo "managers know *how* to apply it. Tiers:"
        echo
        echo "- **generic** — data-driven workhorses (packages, files, settings, repos, shell)."
        echo "- **specific** — bespoke idempotency for a named tool via its own CLI."
        echo "- **engine** — self-management machinery (orchestration, drift, upgrade)."
        echo
        echo "## Generic managers"
        echo
        echo "| Manager | Capabilities | Summary |"
        echo "|---|---|---|"
        emit_rows ${generic[@]+"${generic[@]}"}
        echo
        echo "## Specific managers"
        echo
        echo "| Manager | Capabilities | Summary |"
        echo "|---|---|---|"
        emit_rows ${specific[@]+"${specific[@]}"}
        echo
        echo "## Engine managers"
        echo
        echo "| Manager | Capabilities | Summary |"
        echo "|---|---|---|"
        emit_rows ${engine[@]+"${engine[@]}"}
    }
}

case "${1:-check}" in
    generate)
        validate_and_render > "$DOC"
        echo "Wrote $DOC"
        ;;
    check)
        tmp="$(mktemp)"
        trap 'rm -f "$tmp"' EXIT
        validate_and_render > "$tmp"
        if ! diff -q "$tmp" "$DOC" >/dev/null 2>&1; then
            echo "ERROR: $DOC is out of date — run: scripts/managers generate" >&2
            diff "$DOC" "$tmp" >&2 || true
            exit 1
        fi
        echo "Manager manifests valid; $DOC up to date"
        ;;
    *)
        die "Unknown command: $1 (use 'check' or 'generate')"
        ;;
esac
