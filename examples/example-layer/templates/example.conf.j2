# Example TEMPLATE supplied by a content layer.
#
# Templates are resolved from every layer's templates/ dir, highest priority
# wins, then rendered with the merged variable scope — so they can reference
# engine vars ({{ home_dir }}) and this layer's own vars.yml values.
#
# Declared in capabilities.yml as `src: example.conf` — the lookup key never
# carries the .j2 suffix. Renaming this file to files/example.conf would switch
# it to a verbatim copy with no capability or engine change:
#   config:
#     - src: example.conf
#       dest: "{{ home_dir }}/.config/example/example.conf"

home = {{ home_dir }}
greeting = {{ example_greeting | default('hello') }}
